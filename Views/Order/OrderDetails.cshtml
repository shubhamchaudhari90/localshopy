@using localshopyNew.Constants
@model List<Order>
@{
    ViewData["Title"] = "Order Details";
}
<div class="container mt-4">
    <h3 class="mb-4">Order Details</h3>
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }
    @if (!Model.Any())
    {
        <div class="alert alert-warning">
            No orders found.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var order in Model)
            {
                <div class="col-12 order-card">
                    <div class="card h-100 shadow-sm border-warning">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="fw-bold fs-4 mb-0">
                                    Order #@order.OrderNumber
                                </div>
                                @{
                                    string statusClass = order.Status switch
                                    {
                                        OrderStatus.DELIVERED => "bg-success",
                                        OrderStatus.CANCELLED => "bg-danger",
                                        OrderStatus.REJECTED => "bg-danger",
                                        OrderStatus.PROCESSING => "bg-warning text-dark",
                                        OrderStatus.ACCEPTED => "bg-warning text-dark",
                                        OrderStatus.ORDER_PLACED => "bg-warning text-dark",
                                        OrderStatus.OUT_FOR_DELIVERY => "bg-warning text-dark",
                                        _ => "bg-warning text-dark"
                                    };
                                }
                                <span class="badge @statusClass">
                                    @order.Status
                                </span>
                            </div>
                            <hr class="my-2" />
                            @{
                                int progress = 0;
                                string progressClass = "bg-warning";

                                switch (order.Status)
                                {
                                    case OrderStatus.ORDER_PLACED:
                                        progress = 20;
                                        break;

                                    case OrderStatus.ACCEPTED:
                                        progress = 40;
                                        break;

                                    case OrderStatus.PROCESSING:
                                        progress = 60;
                                        break;

                                    case OrderStatus.OUT_FOR_DELIVERY:
                                        progress = 80;
                                        break;

                                    case OrderStatus.DELIVERED:
                                        progress = 100;
                                        break;

                                    default:
                                        progress = 100;
                                        progressClass = "bg-danger";
                                        break;
                                }
                            }
                            <div class="progress progress-slim">
                                <div class="progress-bar @progressClass progress-bar-animated progress-bar-striped"
                                     role="progressbar"
                                     style="width: @progress%"
                                     aria-valuenow="@progress"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                </div>
                            </div>
                            <hr class="my-2" />
                            <p class="mb-1">
                                <strong>Shop:</strong> @order.ShopName
                            </p>
                            @{
                                TimeZoneInfo istZone = TimeZoneInfo.FindSystemTimeZoneById("Asia/Kolkata");
                                // DateTime today = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, istZone).Date;
                                DateTime now = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, istZone);

                                var duration = now - order.CreatedAt;

                                int days = (int)duration.TotalDays;
                                int hours = duration.Hours;
                                int minutes = duration.Minutes;

                                string timeAgo =
                                days > 0
                                ? $"{days} day{(days > 1 ? "s" : "")} " +
                                $"{hours} hour{(hours != 1 ? "s" : "")}"
                                : hours > 0
                                ? $"{hours} hour{(hours > 1 ? "s" : "")} " +
                                $"{minutes} min{(minutes != 1 ? "s" : "")}"
                                : minutes > 0
                                ? $"{minutes} min{(minutes != 1 ? "s" : "")}"
                                : "Just now";

                                var durationUA = now - order.UpdatedAt;
                                int hoursUA = (int)durationUA.TotalHours;
                                int minutesUA = durationUA.Minutes;
                                string timeAgoUA;

                                if (hoursUA >= 24)
                                {
                                    timeAgoUA = $"{days} day{(days > 1 ? "s" : "")} ago";
                                }
                                else if (hoursUA > 0)
                                {
                                    timeAgoUA = $"{hoursUA} hour{(hoursUA > 1 ? "s" : "")} {minutesUA} min{(minutesUA != 1 ? "s" : "")} ago";
                                }
                                else if (minutesUA > 0)
                                {
                                    timeAgoUA = $"{minutesUA} min{(minutesUA != 1 ? "s" : "")} ago";
                                }
                                else
                                {
                                    timeAgoUA = "Just now";
                                }
                            }
                            <p class="mb-1">
                                <strong>Ordered at:</strong> @order.CreatedAt.ToString("hh:mm tt") (@timeAgo)
                            </p>
                            <p class="mb-1">
                                <strong>Shop Contact No.:</strong>

                                @{
                                    var numbers = (order.ShopContactNumber ?? "")
                                    .Split(',')
                                    .Where(n => !string.IsNullOrWhiteSpace(n))
                                    .ToList();
                                }

                                @for (int i = 0; i < numbers.Count; i++)
                                {
                                    <a href="https://wa.me/@numbers[i]"
                                       target="_blank"
                                       class="text-decoration-none fw-semibold">
                                        @numbers[i]
                                    </a>

                                    @if (i < numbers.Count - 1)
                                    {
                                        <span>, </span>
                                    }
                                }
                            </p>
                            <p class="mb-1">
                                <strong>Last Updated at:</strong>
                                @order.UpdatedAt.ToString("hh:mm tt") (@timeAgoUA)
                            </p>
                            <p class="mb-2">
                                <strong>Shipping Address:</strong><br />
                                @order.ShippingAddress
                            </p>
                            <div class="d-flex justify-content-end align-items-center mb-1">
                                @if (order.IsPreOrder)
                                {
                                    <span class="badge bg-secondary">@OrderStatus.PREORDER</span>
                                }
                            </div>
                            <hr class="my-2" />
                            <div id="collapseOrderItems" class="accordion-collapse collapse show">
                                <div class="accordion-body alert alert-warning">
                                    <div class="row g-3">
                                        @foreach (var item in order.OrderItems)
                                        {
                                            <div class="col-12 col-md-6 col-lg-4 product-card prd@(item.ProductId)">
                                                <div class="card h-100 shadow-sm">
                                                    <div class="row g-0 h-100">
                                                        <!-- Image -->
                                                        <div class="col-3 p-2">
                                                            <div class="ratio ratio-1x1">
                                                                @if (!string.IsNullOrEmpty(item.ImageFileName))
                                                                {
                                                                    <img src="~/uploads/products/@item.ImageFileName"
                                                                         class="card-img-top img-fluid" />
                                                                }
                                                                else
                                                                {
                                                                    <div class="d-flex align-items-center justify-content-center bg-light text-muted w-100" style="aspect-ratio: 1/1;">
                                                                        <i class="bi bi-image fs-3"></i>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                        <div class="col-9 d-flex flex-column p-2">
                                                            <div class="fw-bold text-body text-truncate" style="white-space:nowrap;">
                                                                <a asp-controller="Customer"
                                                                   asp-action="ProductDetail"
                                                                   asp-route-shopProductName="@order.ShopName.Replace("'", "--").Replace(" ", "_")~@item.ProductName.Replace("'", "--").Replace(" ", "_")"
                                                                   class="fw-bold text-body text-decoration-underline d-block text-truncate mb-1"
                                                                   style="white-space: nowrap;">
                                                                    @item.ProductName
                                                                </a>
                                                            </div>
                                                            <div class="d-flex align-items-center justify-content-between mb-1">
                                                                @{
                                                                    string typeColor =
                                                                    item.Type == "Veg" ? "var(--bs-success)" :
                                                                    item.Type == "Egg" ? "var(--bs-warning)" :
                                                                    item.Type == "Non-Veg" ? "var(--bs-danger)" :
                                                                    "";
                                                                }
                                                                <div title="@item.Type"
                                                                     class="d-flex align-items-center justify-content-center flex-shrink-0"
                                                                     style="width:18px; height:18px; border:2px solid @typeColor; border-radius:6px; background:#fff;">
                                                                    <div style="width:10px; height:10px; border-radius:50%; background:@typeColor;"></div>
                                                                </div>
                                                            </div>
                                                            <div class="d-flex align-items-center justify-content-between gap-3">
                                                                <div class="d-flex justify-content-between align-items-center gap-2">
                                                                    <div>
                                                                        <strong>Price:</strong> <span class="text-success">₹@item.UnitPrice</span>
                                                                    </div>
                                                                    <div>
                                                                        <strong>Qty:</strong> @item.Quantity
                                                                    </div>
                                                                    <div>
                                                                        <strong>Total:</strong> <span class="text-success">₹@item.TotalPrice</span>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <hr class="my-2" />
                            <div class="mt-2">
                                <div class="d-flex justify-content-between fw-bold mt-1">
                                    <span>Total</span>
                                    <span>₹@order.TotalAmount</span>
                                </div>
                            </div>
                            <div class="mt-auto pt-3 d-flex gap-2">
                                @if (order.Status == OrderStatus.ORDER_PLACED)
                                {
                                    <form asp-action="Cancel"
                                          asp-controller="Order"
                                          method="post"
                                          class="flex-fill"
                                          onsubmit="return confirm('Are you sure you want to cancel this order?');">
                                        <input type="hidden" name="id" value="@order.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger w-100">
                                            Cancel
                                        </button>
                                    </form>
                                }
                                <a class="btn btn-sm btn-warning flex-fill"
                                   href="@Url.Action("Index", "Order")">
                                    Back
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>