@using localshopyNew.Constants
@model List<Order>

@{
    ViewData["Title"] = "My Orders";
}

<div class="container mt-4">
    <h3 class="mb-4">My Orders</h3>
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }
    @if (!Model.Any())
    {
        <div class="alert alert-warning">
            No orders found.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var order in Model)
            {
                <div class="col-12 order-card">
                    <div class="card h-100 shadow-sm border-warning">
                        <div class="card-body d-flex flex-column">

                            <!-- Header -->
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title mb-0">
                                    Order #@order.OrderNumber
                                </h5>

                                @{
                                    string statusClass = order.Status switch
                                    {
                                        OrderStatus.DELIVERED => "bg-success",
                                        OrderStatus.CANCELLED => "bg-danger",
                                        OrderStatus.REJECTED => "bg-danger",
                                        OrderStatus.PROCESSING => "bg-info text-dark",
                                        _ => "bg-warning text-dark"
                                    };
                                }

                                <span class="badge @statusClass">
                                    @order.Status
                                </span>

                            </div>

                            <hr class="my-2" />

                            <!-- Order Info -->
                            <p class="mb-1">
                                <strong>Shop:</strong> @order.ShopName
                            </p>

                            @*  <p class="mb-1">
                                <strong>Payment:</strong> @order.PaymentStatus
                                @if (!string.IsNullOrEmpty(order.PaymentMethod))
                                {
                                    <span>(@order.PaymentMethod)</span>
                                }
                            </p> *@

                            @{
                                var duration = DateTime.Now - order.CreatedAt;
                                int hours = (int)duration.TotalHours;
                                int minutes = duration.Minutes;
                                string timeAgo;

                                if (hours > 0)
                                    timeAgo = $"{hours} hour{(hours > 1 ? "s" : "")} {minutes} min{(minutes != 1 ? "s" : "")} ago";
                                else if (minutes > 0)
                                    timeAgo = $"{minutes} min{(minutes != 1 ? "s" : "")} ago";
                                else   
                                    timeAgo = "Just now";
                            }
                            <p class="mb-1">
                                <strong>Ordered time:</strong> @order.CreatedAt.ToString("hh:mm tt") (@timeAgo)
                            </p>

                            <p class="mb-2">
                                <strong>Shipping Address:</strong><br />
                                @order.ShippingAddress
                            </p>

                            <hr class="my-2" />

                            <!-- Order Items -->
                            <div id="collapseOrderItems" class="accordion-collapse collapse show">
                                <div class="accordion-body alert alert-warning">
                                    <div class="row g-3">
                                        @foreach (var item in order.OrderItems)
                                        {
                                            <div class="col-12 col-md-6 col-lg-4 product-card prd@(item.ProductId)">
                                                <div class="card h-100 shadow-sm">
                                                    <div class="row g-0 h-100">
                                                        <!-- Image -->
                                                        <div class="col-3 p-2">
                                                            <div class="ratio ratio-1x1">
                                                                @if (!string.IsNullOrEmpty(item.ImageFileName))
                                                                {
                                                                    <img src="~/images/products/@item.ImageFileName"
                                                                         class="card-img-top img-fluid" />
                                                                }
                                                                else
                                                                {
                                                                    <div class="d-flex align-items-center justify-content-center bg-light text-muted w-100" style="aspect-ratio: 1/1;">
                                                                        <i class="bi bi-image fs-3"></i>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>

                                                        <!-- Info -->
                                                        <div class="col-9 d-flex flex-column p-2">
                                                            <div class="fw-bold text-body text-truncate" style="white-space:nowrap;">
                                                                @item.ProductName
                                                            </div>

                                                            <div class="d-flex align-items-center justify-content-between mb-1">
                                                                @* Product Type Indicator *@
                                                                @{
                                                                    string typeColor =
                                                                    item.Type == "Veg" ? "var(--bs-success)" :
                                                                    item.Type == "Egg" ? "var(--bs-warning)" :
                                                                    item.Type == "Non-Veg" ? "var(--bs-danger)" :
                                                                    "";
                                                                }

                                                                <div title="@item.Type"
                                                                     class="d-flex align-items-center justify-content-center flex-shrink-0"
                                                                     style="width:18px; height:18px; border:2px solid @typeColor; border-radius:6px; background:#fff;">
                                                                    <div style="width:10px; height:10px; border-radius:50%; background:@typeColor;"></div>
                                                                </div>
                                                            </div>

                                                            <div class="d-flex align-items-center justify-content-between gap-3">
                                                                <div class="d-flex justify-content-between align-items-center gap-2">
                                                                    <!-- Unit Price -->
                                                                    <div>
                                                                        <strong>Price:</strong> <span class="text-success">₹@item.UnitPrice</span>
                                                                    </div>

                                                                    <!-- Quantity -->
                                                                    <div>
                                                                        <strong>Qty:</strong> @item.Quantity
                                                                    </div>

                                                                    <!-- Total -->
                                                                    <div>
                                                                        <strong>Total:</strong> <span class="text-success">₹@item.TotalPrice</span>
                                                                    </div>
                                                                </div>

                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>


                            <hr class="my-2" />

                            <!-- Total Summary -->
                            <div class="mt-2">
                                @* <div class="d-flex justify-content-between">
                                    <span>Subtotal</span>
                                    <span>₹@order.Subtotal</span>
                                </div>

                                <div class="d-flex justify-content-between">
                                    <span>Tax</span>
                                    <span>₹@order.Tax</span>
                                </div>

                                <div class="d-flex justify-content-between">
                                    <span>Shipping</span>
                                    <span>₹@order.ShippingFee</span>
                                </div> *@

                                <div class="d-flex justify-content-between fw-bold mt-1">
                                    <span>Total</span>
                                    <span>₹@order.TotalAmount</span>
                                </div>
                            </div>

                            <!-- Actions -->
                            <div class="mt-auto pt-3 d-flex gap-2">
                                <a class="btn btn-sm btn-warning flex-fill"
                                   href="@Url.Action("Index", "Order")">
                                    Back
                                </a>

                                @if (order.Status == OrderStatus.ORDER_PLACED)
                                {
                                    <form asp-action="Cancel"
                                          asp-controller="Order"
                                          method="post"
                                          class="flex-fill"
                                          onsubmit="return confirm('Are you sure you want to cancel this order?');">

                                        <input type="hidden" name="id" value="@order.Id" />

                                        <button type="submit" class="btn btn-sm btn-danger w-100">
                                            Cancel
                                        </button>
                                    </form>


                                }
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
