@using localshopyNew.Constants
@model List<Order>

@{
    ViewData["Title"] = "All Orders";
}

<div class="container mt-4">
    <h3 class="mb-4">All Orders</h3>
    @if (ViewData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @ViewData["ErrorMessage"]
        </div>
    }
    @if (!Model.Any())
    {
        <div class="card border-info mb-3">
            <div class="card-body text-info">
                <h5 class="card-title"><strong>No order found.</strong></h5>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var order in Model)
            {

                // Determine badge color
                string statusClass = order.Status switch
                {
                    OrderStatus.DELIVERED => "bg-success",
                    OrderStatus.CANCELLED => "bg-danger",
                    OrderStatus.REJECTED => "bg-danger",
                    OrderStatus.PROCESSING => "bg-info text-dark",
                    _ => "bg-warning text-dark"
                };

                // Duration in hours & minutes
                var duration = DateTime.Now - order.CreatedAt;
                int hours = (int)duration.TotalHours;
                int minutes = duration.Minutes;
                string timeAgo = hours > 0
                ? $"{hours} hour{(hours > 1 ? "s" : "")} {minutes} min{(minutes != 1 ? "s" : "")} ago"
                : minutes > 0
                ? $"{minutes} min{(minutes != 1 ? "s" : "")} ago"
                : "Just now";


                <div class="col-12 col-md-6 col-lg-4">
                    <a href="@Url.Action("OrderDetails", "Order", new { id = order.Id })" class="text-decoration-none text-dark">
                        <div class="card h-100 shadow-sm border-warning">
                            <div class="card-body d-flex flex-column">

                                <!-- Header -->
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title mb-0">Order #@order.OrderNumber</h5>
                                    <span class="badge @statusClass">@order.Status</span>
                                </div>

                                <hr class="my-2" />

                                <div class="mb-1"><strong>Shop:</strong> @order.ShopName</div>

                                <div class="mb-1">
                                    <strong>Ordered time:</strong> @order.CreatedAt.ToString("hh:mm tt") (@timeAgo)
                                </div>

                                <div class="mb-1"><strong>Items:</strong> @order.OrderItems.Count | Qty: @order.OrderItems.Sum(x => x.Quantity)</div>
                                <div class="mb-1"><strong>Total:</strong> ₹@order.TotalAmount</div>

                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>
