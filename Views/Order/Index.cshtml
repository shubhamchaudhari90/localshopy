@model List<Order>

@{
    ViewData["Title"] = "All Orders";
}

<div class="container mt-4">
    <h3 class="mb-4">All Orders</h3>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">
            No orders found.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var order in Model)
            {

                // Determine badge color
                string statusClass = order.Status switch
                {
                    "DELIVERED" => "bg-success",
                    "CANCELLED" => "bg-danger",
                    "REJECTED" => "bg-danger",
                    "PROCESSING" => "bg-info text-dark",
                    _ => "bg-warning text-dark"
                };

                // Duration in hours & minutes
                var duration = DateTime.Now - order.CreatedAt;
                int hours = (int)duration.TotalHours;
                int minutes = duration.Minutes;
                string timeAgo = hours > 0
                ? $"{hours} hour{(hours > 1 ? "s" : "")} {minutes} min{(minutes != 1 ? "s" : "")} ago"
                : minutes > 0
                ? $"{minutes} min{(minutes != 1 ? "s" : "")} ago"
                : "Just now";


                <div class="col-12 col-md-6 col-lg-4">
                    <a href="@Url.Action("OrderDetails", "Order", new { id = order.Id })" class="text-decoration-none text-dark">
                        <div class="card h-100 shadow-sm border-warning">
                            <div class="card-body d-flex flex-column">

                                <!-- Header -->
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title mb-0">Order #@order.OrderNumber</h5>
                                    <span class="badge @statusClass">@order.Status</span>
                                </div>

                                <hr class="my-2" />

                                <!-- Order Info -->
                                <p class="mb-1"><strong>Shop:</strong> @order.ShopName</p>
                                <p class="mb-1">
                                    <strong>Order Date:</strong> @order.CreatedAt.ToString("dd MMM yyyy hh:mm tt")
                                    <span class="text-muted">(@timeAgo)</span>
                                </p>
                                <p class="mb-1"><strong>Items:</strong> @order.OrderItems.Count</p>
                                <p class="mb-1"><strong>Total:</strong> ₹@order.TotalAmount</p>

                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>
