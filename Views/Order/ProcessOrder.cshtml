@using localshopyNew.Constants
@model List<Order>

@{
    ViewData["Title"] = "Process Order";
}

<div class="container mt-4">
    <h3 class="mb-4">Process Order</h3>
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }
    @if (!Model.Any())
    {
        <div class="alert alert-warning">
            No orders found.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var order in Model)
            {
                <div class="col-12 order-card">
                    <div class="card h-100 shadow-sm border-warning">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="fw-bold fs-4 mb-0">
                                    Order #@order.OrderNumber
                                </div>
                                @{
                                    string statusClass = order.Status switch
                                    {
                                        OrderStatus.DELIVERED => "bg-success",
                                        OrderStatus.CANCELLED => "bg-danger",
                                        OrderStatus.REJECTED => "bg-danger",
                                        OrderStatus.PROCESSING => "bg-warning text-dark",
                                        OrderStatus.ACCEPTED => "bg-warning text-dark",
                                        OrderStatus.ORDER_PLACED => "bg-warning text-dark",
                                        OrderStatus.OUT_FOR_DELIVERY => "bg-warning text-dark",
                                        _ => "bg-warning text-dark"
                                    };
                                }
                                <span class="badge @statusClass">
                                    @order.Status
                                </span>
                            </div>
                            <hr class="my-2" />
                            @{
                                int progress = 0;
                                string progressClass = "bg-warning";

                                switch (order.Status)
                                {
                                    case OrderStatus.ORDER_PLACED:
                                        progress = 20;
                                        break;

                                    case OrderStatus.ACCEPTED:
                                        progress = 40;
                                        break;

                                    case OrderStatus.PROCESSING:
                                        progress = 60;
                                        break;

                                    case OrderStatus.OUT_FOR_DELIVERY:
                                        progress = 80;
                                        break;

                                    case OrderStatus.DELIVERED:
                                        progress = 100;
                                        break;

                                    default:
                                        progress = 100;
                                        progressClass = "bg-danger";
                                        break;
                                }
                            }
                            <div class="progress">
                                <div class="progress-bar @progressClass"
                                     role="progressbar"
                                     style="width: @progress%"
                                     aria-valuenow="@progress"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                </div>
                            </div>

                            <hr class="my-2" />

                            @{
                                var duration = DateTime.Now - order.CreatedAt;
                                int hours = (int)duration.TotalHours;
                                int minutes = duration.Minutes;
                                string timeAgo;

                                if (hours > 0)
                                    timeAgo = $"{hours} hour{(hours > 1 ? "s" : "")} {minutes} min{(minutes != 1 ? "s" : "")}";
                                else if (minutes > 0)
                                    timeAgo = $"{minutes} min{(minutes != 1 ? "s" : "")}";
                                else
                                    timeAgo = "Just now";
                            }
                            <p class="mb-1">
                                <strong>Ordered at:</strong> @order.CreatedAt.ToString("hh:mm tt") (@timeAgo)
                            </p>
                            <p class="mb-2">
                                <strong>Shipping Address:</strong><br />
                                @order.ShippingAddress
                            </p>
                            <hr class="my-2" />
                            <div id="collapseOrderItems" class="accordion-collapse collapse show">
                                <div class="accordion-body alert alert-warning">
                                    <div class="row g-3">
                                        @foreach (var item in order.OrderItems)
                                        {
                                            <div class="col-12 col-md-6 col-lg-4 product-card prd@(item.ProductId)">
                                                <div class="card h-100 shadow-sm">
                                                    <div class="row g-0 h-100">
                                                        <div class="col-3 p-2">
                                                            <div class="ratio ratio-1x1">
                                                                @if (!string.IsNullOrEmpty(item.ImageFileName))
                                                                {
                                                                    <img src="~/images/products/@item.ImageFileName"
                                                                         class="card-img-top img-fluid" />
                                                                }
                                                                else
                                                                {
                                                                    <div class="d-flex align-items-center justify-content-center bg-light text-muted w-100" style="aspect-ratio: 1/1;">
                                                                        <i class="bi bi-image fs-3"></i>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                        <div class="col-9 d-flex flex-column p-2">
                                                            <div class="fw-bold text-body text-truncate" style="white-space:nowrap;">
                                                                @item.ProductName
                                                            </div>
                                                            <div class="d-flex align-items-center justify-content-between mb-1">
                                                                @{
                                                                    string typeColor =
                                                                    item.Type == "Veg" ? "var(--bs-success)" :
                                                                    item.Type == "Egg" ? "var(--bs-warning)" :
                                                                    item.Type == "Non-Veg" ? "var(--bs-danger)" :
                                                                    "";
                                                                }
                                                                <div title="@item.Type"
                                                                     class="d-flex align-items-center justify-content-center flex-shrink-0"
                                                                     style="width:18px; height:18px; border:2px solid @typeColor; border-radius:6px; background:#fff;">
                                                                    <div style="width:10px; height:10px; border-radius:50%; background:@typeColor;"></div>
                                                                </div>
                                                            </div>
                                                            <div class="d-flex align-items-center justify-content-between gap-3">
                                                                <div class="d-flex justify-content-between align-items-center gap-2">
                                                                    <div>
                                                                        <strong>Price:</strong> <span class="text-success">₹@item.UnitPrice</span>
                                                                    </div>

                                                                    <div>
                                                                        <strong>Qty:</strong> @item.Quantity
                                                                    </div>

                                                                    <div>
                                                                        <strong>Total:</strong> <span class="text-success">₹@item.TotalPrice</span>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <hr class="my-2" />
                            <div class="mt-2">
                                <div class="d-flex justify-content-between fw-bold mt-1">
                                    <span>Total</span>
                                    <span>₹@order.TotalAmount</span>
                                </div>
                            </div>
                            <div class="mt-auto pt-3 d-flex gap-2">

                                @if (order.Status == OrderStatus.ORDER_PLACED)
                                {
                                    <form asp-action="Reject" asp-controller="Order" method="post" class="flex-fill"
                                          onsubmit="return confirm('Are you sure you want to REJECT this order?');">
                                        <input type="hidden" name="id" value="@order.Id" />
                                        <button type="submit" class="fw-bold btn btn-sm btn-danger w-100">
                                            Reject
                                        </button>
                                    </form>
                                    <a class="fw-bold btn btn-sm btn-secondary flex-fill"
                                       href="@Url.Action("OrdersToServe", "Order")">
                                        Back
                                    </a>
                                    <form asp-action="Accept" asp-controller="Order" method="post" class="flex-fill">
                                        <input type="hidden" name="id" value="@order.Id" />
                                        <button type="submit" class="fw-bold btn btn-sm btn-warning w-100">
                                            Accept
                                        </button>
                                    </form>
                                }

                                @if (order.Status == OrderStatus.ACCEPTED)
                                {
                                    <a class="fw-bold btn btn-sm btn-secondary flex-fill"
                                       href="@Url.Action("OrdersToServe", "Order")">
                                        Back
                                    </a>
                                    <form asp-action="Processing" asp-controller="Order" method="post" class="flex-fill">
                                        <input type="hidden" name="id" value="@order.Id" />
                                        <button type="submit" class="fw-bold btn btn-sm btn-warning w-100">
                                            @OrderStatus.PROCESSING
                                        </button>
                                    </form>
                                }

                                @if (order.Status == OrderStatus.PROCESSING)
                                {
                                    <a class="fw-bold btn btn-sm btn-secondary flex-fill"
                                       href="@Url.Action("OrdersToServe", "Order")">
                                        Back
                                    </a>
                                    <form asp-action="OutForDelivery" asp-controller="Order" method="post" class="flex-fill">
                                        <input type="hidden" name="id" value="@order.Id" />
                                        <button type="submit" class="fw-bold btn btn-sm btn-warning w-100">
                                            @OrderStatus.OUT_FOR_DELIVERY
                                        </button>
                                    </form>
                                }

                                @if (order.Status == OrderStatus.OUT_FOR_DELIVERY)
                                {
                                    <a class="fw-bold btn btn-sm btn-secondary flex-fill"
                                       href="@Url.Action("OrdersToServe", "Order")">
                                        Back
                                    </a>
                                    <form asp-action="Delivered" asp-controller="Order" method="post" class="flex-fill">
                                        <input type="hidden" name="id" value="@order.Id" />
                                        <button type="submit" class="fw-bold btn btn-sm btn-warning w-100">
                                            @OrderStatus.DELIVERED
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>