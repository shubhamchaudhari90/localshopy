@using localshopyNew.Constants
@model List<Order>

@{
    ViewData["Title"] = "All Orders";
}

<div class="container mt-4">
    <h3 class="mb-4">All Orders</h3>
    @if (ViewData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @ViewData["ErrorMessage"]
        </div>
    }
    @if (!Model.Any())
    {
        <div class="card border-info mb-3">
            <div class="card-body text-info">
                <h5 class="card-title"><strong>No order found.</strong></h5>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var order in Model)
            {

                // Determine badge color
                string statusClass = order.Status switch
                {
                    OrderStatus.DELIVERED => "bg-success",
                    OrderStatus.CANCELLED => "bg-danger",
                    OrderStatus.REJECTED => "bg-danger",
                    OrderStatus.PROCESSING => "bg-warning text-dark",
                    OrderStatus.ACCEPTED => "bg-warning text-dark",
                    OrderStatus.ORDER_PLACED => "bg-warning text-dark",
                    OrderStatus.OUT_FOR_DELIVERY => "bg-warning text-dark",
                    _ => "bg-warning text-dark"
                };

                // Duration in hours & minutes
                var duration = DateTime.Now - order.CreatedAt;
                int hours = (int)duration.TotalHours;
                int minutes = duration.Minutes;
                string timeAgo = hours > 0
                ? $"{hours} hour{(hours > 1 ? "s" : "")} {minutes} min{(minutes != 1 ? "s" : "")}"
                : minutes > 0
                ? $"{minutes} min{(minutes != 1 ? "s" : "")}"
                : "Just now";

                <div class="col-12 col-md-6 col-lg-4">
                    <form asp-controller="Order" asp-action="ProcessOrder" method="post" class="h-100">
                        <input type="hidden" name="id" value="@order.Id" />

                        <button type="submit" class="w-100 text-start p-0 border-0 bg-transparent">
                            <div class="card h-100 shadow-sm border-warning">
                                <div class="card-body d-flex flex-column">

                                    <!-- Header -->
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <strong>
                                            Order #@order.OrderNumber
                                        </strong>
                                        <span class="badge @statusClass">@order.Status</span>
                                    </div>

                                    <hr class="my-2" />
                                    @{
                                        int progress = 0;
                                        string progressClass = "bg-warning";

                                        switch (order.Status)
                                        {
                                            case OrderStatus.ORDER_PLACED:
                                                progress = 20;
                                                break;

                                            case OrderStatus.ACCEPTED:
                                                progress = 40;
                                                break;

                                            case OrderStatus.PROCESSING:
                                                progress = 60;
                                                break;

                                            case OrderStatus.OUT_FOR_DELIVERY:
                                                progress = 80;
                                                break;

                                            case OrderStatus.DELIVERED:
                                                progress = 100;
                                                break;

                                            default:
                                                progress = 100;
                                                progressClass = "bg-danger";
                                                break;
                                        }
                                    }
                                    
                                    <div class="progress progress-slim">
                                        <div class="progress-bar @progressClass progress-bar-animated progress-bar-striped"
                                             role="progressbar"
                                             style="width: @progress%"
                                             aria-valuenow="@progress"
                                             aria-valuemin="0"
                                             aria-valuemax="100">
                                        </div>
                                    </div>

                                    <hr class="my-2" />

                                    <div class="mb-1">
                                        <strong>Ordered at:</strong> @order.CreatedAt.ToString("hh:mm tt") (@timeAgo)
                                    </div>

                                    <div class="mb-1">
                                        <strong>Items:</strong> @order.OrderItems.Count |
                                        Qty: @order.OrderItems.Sum(x => x.Quantity)
                                    </div>

                                    <div class="mb-1"><strong>Total:</strong> ₹@order.TotalAmount</div>

                                </div>
                            </div>
                        </button>
                    </form>
                </div>

            }
        </div>
    }
</div>
