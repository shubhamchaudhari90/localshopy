@using localshopyNew.ViewModel
@model IEnumerable<ProductViewModel>

@{
    var groupedProducts = Model
        .GroupBy(p => p.CategoryName ?? "Other")
        .ToList();
}

@if (groupedProducts.Any())
{
    <!-- Toggle Button -->
    <div class="d-flex justify-content-end mb-3">
        <button id="toggleAllBtn" class="btn btn-warning btn-sm">
            <i class="bi bi-arrows-collapse"></i> Collapse All
        </button>
    </div>

    <div class="accordion" id="productCategoryAccordion">

        @foreach (var group in groupedProducts.Select((g, idx) => new { g, idx }))
        {
            var category = group.g.Key;
            var index = group.idx;
            var collapseId = $"collapse-{index}";
            var headingId = $"heading-{index}";
            var products = group.g.OrderBy(x => Guid.NewGuid()).ToList();

            <div class="accordion-item mb-2">
                <h2 class="accordion-header" id="@headingId">
                    <button class="accordion-button bg-warning text-dark fw-semibold"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#@collapseId"
                            aria-expanded="true">
                        @category (@products.Count())
                    </button>
                </h2>

                <div id="@collapseId" class="accordion-collapse collapse show">
                    <div class="accordion-body alert alert-warning">

                        <div class="row g-3">
                            @foreach (var product in products)
                            {
                                bool discountActive =
                                product.Discount > 0 &&
                                product.DiscountValidFrom.HasValue &&
                                product.DiscountValidTill.HasValue &&
                                DateTime.Today >= product.DiscountValidFrom.Value.Date &&
                                DateTime.Today <= product.DiscountValidTill.Value.Date;

                                string cardClass = product.IsAvailable
                                ? ""
                                : "border-secondary bg-secondary bg-opacity-10";

                                <div class="col-12 col-md-6 col-lg-4">
                                    <div class="card h-100 shadow-sm @cardClass">
                                        <div class="row g-0 h-100">

                                            <!-- Image -->
                                            <div class="col-3 p-2">
                                                <div class="ratio ratio-1x1">
                                                    @if (!string.IsNullOrEmpty(product.ImageFileName))
                                                    {
                                                        <img src="~/images/products/@product.ImageFileName"
                                                             class="img-fluid rounded object-fit-cover" />
                                                    }
                                                    else
                                                    {
                                                        <div class="d-flex align-items-center justify-content-center bg-light text-muted rounded">
                                                            <i class="bi bi-image fs-3"></i>
                                                        </div>
                                                    }
                                                </div>
                                            </div>

                                            <!-- Product Data -->
                                            <div class="col-9 d-flex flex-column p-2">

                                                <!-- PRODUCT NAME (SINGLE LINE) -->
                                                <a asp-controller="Customer"
                                                   asp-action="ProductDetail"
                                                   asp-route-shopProductName="@product.ShopName.Replace("-", "--").Replace(" ", "-")_@product.ProductMasterName.Replace("-", "--").Replace(" ", "-")"
                                                   class="fw-bold text-body text-decoration-underline d-block text-truncate mb-1"
                                                   style="white-space: nowrap;">
                                                    @product.ProductMasterName
                                                </a>

                                                <!-- SHOP NAME + TYPE (SAME LINE) -->
                                                <div class="d-flex align-items-center justify-content-between mb-1">
                                                    <a asp-controller="Customer"
                                                       asp-action="ShopDetails"
                                                       asp-route-shopName="@product.ShopName.Replace("-", "--").Replace(" ", "-")"
                                                       class="fw-semibold text-secondary text-decoration-underline text-truncate d-block"
                                                       style="max-width: calc(100% - 26px); white-space: nowrap;"
                                                       title="@product.ShopName">@product.ShopName
                                                    </a>

                                                    @{
                                                        string typeColor =
                                                        product.Type == "Veg" ? "var(--bs-success)" :
                                                        product.Type == "Egg" ? "var(--bs-warning)" :
                                                        product.Type == "Non-Veg" ? "var(--bs-danger)" :
                                                        "";
                                                    }

                                                    <!-- Type Icon -->
                                                    <div title="@product.Type"
                                                         class="d-flex align-items-center justify-content-center flex-shrink-0"
                                                         style="width:18px; height:18px; border:2px solid @typeColor; border-radius:6px; background:#fff;">

                                                        <div style="width:10px; height:10px; border-radius:50%; background-color:@typeColor;">
                                                        </div>

                                                    </div>
                                                </div>

                                                


                                                <!-- RATING (LEFT) + PRICE (RIGHT) -->
                                                <div class="d-flex align-items-center justify-content-between">

                                                    <!-- ⭐ Rating -->
                                                    <div class="d-flex align-items-center">
                                                        @if (product.AverageRating > 0)
                                                        {
                                                            <span class="text-warning me-1" style="font-size:13px;">
                                                                @{
                                                                    int fullStars = (int)Math.Floor(product.AverageRating);
                                                                    bool halfStar = product.AverageRating - fullStars >= 0.5;

                                                                    for (int i = 1; i <= 5; i++)
                                                                    {
                                                                        if (i <= fullStars)
                                                                        {
                                                                            <i class="bi bi-star-fill"></i>
                                                                        }
                                                                        else if (i == fullStars + 1 && halfStar)
                                                                        {
                                                                            <i class="bi bi-star-half"></i>
                                                                        }
                                                                        else
                                                                        {
                                                                            <i class="bi bi-star"></i>
                                                                        }
                                                                    }
                                                                }
                                                            </span>

                                                            @if (product.ReviewCount > 0)
                                                            {
                                                                <small class="text-muted">(@product.ReviewCount)</small>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <p class="text-muted mb-0">No reviews yet.</p>
                                                        }
                                                    </div>

                                                    <!-- 💰 Price -->
                                                    <div class="text-end">
                                                        @if (discountActive)
                                                        {
                                                            <span class="text-muted text-decoration-line-through small me-1">
                                                                ₹@product.Price
                                                            </span>
                                                        }
                                                        <span class="fw-bold text-success">
                                                            ₹@product.FinalPrice
                                                        </span>
                                                    </div>

                                                </div>


                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Accordion Script -->
    <script>
        function initializeAccordionPartial() {
            const toggleBtn = document.getElementById("toggleAllBtn");
            const accordionEls = document.querySelectorAll(".accordion-collapse");

            if (!toggleBtn || accordionEls.length === 0) return;

            const collapses = Array.from(accordionEls).map(el =>
                new bootstrap.Collapse(el, { toggle: false })
            );

            function updateButtonText() {
                const openCount = document.querySelectorAll(".accordion-collapse.show").length;
                toggleBtn.innerHTML = openCount > 0
                    ? '<i class="bi bi-arrows-collapse"></i> Collapse All'
                    : '<i class="bi bi-arrows-expand"></i> Expand All';
            }

            toggleBtn.addEventListener("click", function () {
                const expand = document.querySelectorAll(".accordion-collapse.show").length === 0;
                collapses.forEach(c => expand ? c.show() : c.hide());
                setTimeout(updateButtonText, 200);
            });

            accordionEls.forEach(el => {
                el.addEventListener("shown.bs.collapse", updateButtonText);
                el.addEventListener("hidden.bs.collapse", updateButtonText);
            });

            updateButtonText();
        }

        initializeAccordionPartial();
    </script>
}
else
{
    <div class="card border-warning shadow-sm text-center">
        <div class="card-body alert alert-warning mb-0 rounded">
            <i class="bi bi-exclamation-circle fs-1 text-warning"></i>
            <h5 class="fw-bold text-dark mt-2">No Products Found</h5>
            <p class="text-muted mb-0">Please select categories to see available products.</p>
        </div>
    </div>
}
