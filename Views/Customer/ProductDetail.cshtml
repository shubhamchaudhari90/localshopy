@using localshopyNew.ViewModel
@model ProductViewModel
@{
    ViewData["Title"] = "Product Details";
}

@{
    bool discountActive = Model.Discount > 0 &&
        Model.DiscountValidFrom.HasValue &&
        Model.DiscountValidTill.HasValue &&
        DateTime.Today >= Model.DiscountValidFrom.Value.Date &&
        DateTime.Today <= Model.DiscountValidTill.Value.Date;
}


<div class="container mt-5 d-flex justify-content-center">
    <div class="card shadow-sm animate__animated animate__fadeInUp w-100" style="max-width: 1100px;">
        <div class="card-body p-4">

            <!-- Header -->
            <div class="text-center mb-4">
                <!-- Product Name -->
                <div class="animate__animated animate__fadeInDown fw-bold"
                     style="font-size: 2.2rem; line-height: 1.2;">
                    @Model.ProductMasterName
                </div>
            </div>

            <!-- Product Details -->
            <div class="row g-3 align-items-start">

                <!-- IMAGE -->
                <div class="col-3 col-lg-2 col-md-2">
                    <div class="ratio ratio-1x1">
                        @if (!string.IsNullOrEmpty(Model.ImageFileName))
                        {
                            <img src="~/images/products/@Model.ImageFileName"
                                 class="img-fluid rounded object-fit-cover" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-light text-muted rounded">
                                <i class="bi bi-image fs-4"></i>
                            </div>
                        }
                    </div>
                </div>

                <!-- CONTENT -->
                <div class="col-9 col-lg-10 col-md-10">

                    <!-- SHOP NAME + TYPE -->
                    <div class="d-flex align-items-center justify-content-between mb-2">

                        <a asp-controller="Customer"
                           asp-action="ShopDetails"
                           asp-route-shopName="@Model.ShopName.Replace("-", "--").Replace(" ", "-")"
                           class="fw-semibold text-secondary text-decoration-underline text-truncate"
                           style="max-width: calc(100% - 22px);"
                           title="@Model.ShopName">
                            @Model.ShopName
                        </a>

                        @{
                            string typeColor =
                            Model.Type == "Veg" ? "var(--bs-success)" :
                            Model.Type == "Egg" ? "var(--bs-warning)" :
                            Model.Type == "Non-Veg" ? "var(--bs-danger)" :
                            "";
                        }

                        <div title="@Model.Type"
                             class="d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width:16px;height:16px;border:2px solid @typeColor;border-radius:4px;">
                            <div style="width:8px;height:8px;border-radius:50%;background:@typeColor;"></div>
                        </div>

                    </div>

                    <!-- DESCRIPTION + PRICE -->
                    <div class="d-flex align-items-center justify-content-between">

                        <p class="text-muted text-truncate mb-0 me-2">
                            @Model.Description
                        </p>

                        <div class="d-flex align-items-center gap-2 flex-shrink-0">
                            @if (discountActive)
                            {
                                <span class="text-muted text-decoration-line-through small">
                                    ₹@Model.Price
                                </span>
                                <span class="text-warning fw-semibold small">
                                    -@Model.Discount%
                                </span>
                            }
                            <span class="fw-bold text-success">
                                ₹@Model.FinalPrice
                            </span>
                        </div>

                    </div>

                </div>
            </div>

            <hr />

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0">Reviews</h4>
            </div>
            <div class="accordion" id="reviewAccordion">

                <!-- ================= Customer Reviews ================= -->
                <div class="accordion-item shadow-sm mb-2">
                    <h2 class="accordion-header" id="headingReviews">
                        <button class="accordion-button bg-warning text-dark fw-semibold"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#collapseReviews"
                                aria-expanded="true"
                                aria-controls="collapseReviews">
                            Customer Reviews
                            @if (Model.ReviewCount > 0)
                            {
                                <span class="ms-2 text-muted">(@Model.ReviewCount)</span>
                            }
                        </button>
                    </h2>

                    <div id="collapseReviews"
                         class="accordion-collapse collapse show"
                         aria-labelledby="headingReviews">

                        <div class="accordion-body  alert alert-warning p-2"
                             style="max-height: 350px; overflow-y: auto;">

                            @if (Model.Reviews != null && Model.Reviews.Any())
                            {
                                @foreach (var review in Model.Reviews)
                                {
                                    <div class="card mb-2 shadow-sm">
                                        <div class="card-body p-3">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <strong>@review.Reviewer</strong>

                                                <div class="text-warning">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        if (i <= review.Rating)
                                                        {
                                                            <i class="bi bi-star-fill"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-star"></i>
                                                        }
                                                    }
                                                </div>
                                            </div>

                                            <small class="text-muted">
                                                @review.CreatedAt.ToString("dd MMM yyyy")
                                            </small>

                                            <p class="mb-0 mt-2">@review.Comment</p>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted text-center mb-0 p-2">
                                    No reviews.
                                </p>
                            }
                        </div>
                    </div>
                </div>
                @if (TempData["Order"] != null)
                {
                    <!-- ================= Add Review ================= -->
                    <div class="accordion-item shadow-sm">
                        <h2 class="accordion-header" id="headingAddReview">
                            <button class="accordion-button bg-warning text-dark fw-semibold"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapseAddReview"
                                    aria-expanded="true"
                                    aria-controls="collapseAddReview">
                                Add Review
                            </button>
                        </h2>

                        <div id="collapseAddReview"
                             class="accordion-collapse collapse show"
                             aria-labelledby="headingAddReview">

                            <div class="accordion-body alert alert-warning">

                                @if (User.Identity?.IsAuthenticated != true)
                                {
                                    <p class="text-muted mb-0">
                                        Please login with Google to submit a review.
                                    </p>
                                }
                                else if (User.Identity.IsAuthenticated && !Model.IsReviewed)
                                {
                                    <form asp-controller="Customer"
                                          asp-action="AddReview"
                                          method="post">

                                        <input type="hidden" name="ProductId" value="@Model.Id" />

                                        <!-- Rating Stars -->
                                        <div id="ratingStars"
                                             class="text-warning mb-2 fs-5"
                                             style="cursor: pointer;">
                                            <i class="bi bi-star" data-value="1"></i>
                                            <i class="bi bi-star" data-value="2"></i>
                                            <i class="bi bi-star" data-value="3"></i>
                                            <i class="bi bi-star" data-value="4"></i>
                                            <i class="bi bi-star" data-value="5"></i>
                                        </div>

                                        <input type="hidden" name="Rating" id="ratingValue" />

                                        <div class="mb-2">
                                            <label class="form-label">Comment</label>
                                            <textarea name="Comment"
                                              class="form-control"
                                              rows="3"
                                              maxlength="200"
                                              placeholder="Write your review..."></textarea>
                                        </div>

                                        <button type="submit" class="btn btn-sm btn-warning">
                                            Submit Review
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <p class="text-muted mb-0">
                                        You have already submitted a review for this product.
                                    </p>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

<script>
    document.querySelectorAll('#ratingStars i').forEach(star => {
        star.addEventListener('click', function () {
            let rating = this.getAttribute('data-value');
            document.getElementById('ratingValue').value = rating;

            document.querySelectorAll('#ratingStars i').forEach((s, i) => {
                s.classList.toggle('bi-star-fill', i < rating);
                s.classList.toggle('bi-star', i >= rating);
            });
        });
    });

    // All reviews from server
    const reviews = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
    const pageSize = 3; // Reviews per page
    let currentPage = 1;
    const totalPages = Math.ceil(reviews.length / pageSize);

    // Render reviews for current page
    function renderReviews() {
        const start = (currentPage - 1) * pageSize;
        const end = start + pageSize;
        const paged = reviews.slice(start, end);

        const container = document.getElementById('reviewsContainer');
        container.innerHTML = '';

        paged.forEach(r => {
            const stars = Array.from({length:5}, (_,i) => i < r.Rating ? '<i class="bi bi-star-fill"></i>' : '<i class="bi bi-star"></i>').join('');
            container.innerHTML += `
                <div class="border-bottom pb-2 mb-2">
                    <div class="d-flex justify-content-between">
                        <strong>${r.Reviewer}</strong>
                        <div class="text-warning">${stars}</div>
                    </div>
                    <small class="text-muted">${new Date(r.CreatedAt).toLocaleDateString()}</small>
                    <p class="mb-1">${r.Comment}</p>
                </div>
            `;
        });

        renderPagination();
    }

    // Render pagination links
    function renderPagination() {
        const container = document.getElementById('paginationContainer');
        container.innerHTML = '';

        // Previous button
        const prevDisabled = currentPage === 1 ? 'disabled' : '';
        container.innerHTML += `<li class="page-item ${prevDisabled}">
            <a class="page-link" href="#" onclick="goPage(${currentPage - 1}); return false;">Previous</a>
        </li>`;

        // Page numbers
        for(let i=1; i<=totalPages; i++){
            const active = i === currentPage ? 'active' : '';
            container.innerHTML += `<li class="page-item ${active}">
                <a class="page-link" href="#" onclick="goPage(${i}); return false;">${i}</a>
            </li>`;
        }

        // Next button
        const nextDisabled = currentPage === totalPages ? 'disabled' : '';
        container.innerHTML += `<li class="page-item ${nextDisabled}">
            <a class="page-link" href="#" onclick="goPage(${currentPage + 1}); return false;">Next</a>
        </li>`;
    }

    // Navigate to a page
    function goPage(page){
        if(page < 1 || page > totalPages) return;
        currentPage = page;
        renderReviews();
    }

    // Initial render
    renderReviews();
</script>



<style>
    .custom-ratio {
        position: relative;
        width: 100%;
        padding-top: 75%; /* 0.75 times the width */
    }

        .custom-ratio img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover; /* keeps the image nicely scaled */
        }

</style>