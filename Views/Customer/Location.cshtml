@using localshopyNew.ViewModel
@model LocationViewModel

<div class="d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow-sm alert alert-warning " style="max-width: 420px; width: 100%;">
        <div class="card-body p-4">

            <h5 class="card-title text-center mb-3">
                Choose Your Location
            </h5>

            <p class="text-muted text-center mb-4">
                Choose a location to see which products are available there.
            </p>

            <form asp-action="Location" method="post">

                <div class="mb-4">
                    <label asp-for="SelectedLocationId" class="form-label fw-semibold">
                        Location
                    </label>

                    <select asp-for="SelectedLocationId"
                            asp-items="@(new SelectList(Model.Locations, "Id", "Name"))"
                            class="form-select"
                            required>
                        <option value="">-- Select Location --</option>
                    </select>

                    <span asp-validation-for="SelectedLocationId"
                          class="text-danger small"></span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-warning btn-lg">
                        Continue
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>