@model IEnumerable<Categoty>

<div class="pt-4 pb-3">

    <!-- Row: location left + category dropdown right -->
    <div class="d-flex justify-content-between align-items-center mb-2">

        <!-- Left: Change Location -->
        <div class="text-start">
            <a asp-controller="Customer" asp-action="ChangeLocation"
               class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-geo-alt"></i> Change Location
            </a>
        </div>


        <!-- Open Popup Button -->
        <div class="text-end">
            <button type="button" class="btn btn-warning" id="openCategoryModal">
                Select Categories
            </button>
        </div>

        <!-- Hidden input -->
        <input type="hidden" id="selectedCategories" />

        <!-- Selected categories text -->
        <div class="mt-2 text-end fw-semibold">
            <span id="selectedCategoriesText">No categories selected</span>
        </div>

        <!-- Modal -->
        <div class="modal fade" id="categoryModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-scrollable">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">Select Categories</h5>
                        <button type="button" class="btn-close"
                                data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <form id="categoryModalForm">
                            @foreach (var cat in Model)
                            {
                                <div class="form-check mb-1">
                                    <input class="form-check-input category-checkbox"
                                           type="checkbox"
                                           value="@cat.Name"
                                           id="modal_cat_@cat.Name" />
                                    <label class="form-check-label"
                                           for="modal_cat_@cat.Name">
                                        @cat.Name
                                    </label>
                                </div>
                            }

                            <div class="mt-3 text-end">
                                <button id="btnApply" type="submit" class="btn btn-success btn-sm">
                                    Apply
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div id="productContainer">
    <!-- Products will be loaded here -->
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const modalElement = document.getElementById("categoryModal");
        const categoryModal = new bootstrap.Modal(modalElement);

        // Open modal
        document.getElementById("openCategoryModal")
            .addEventListener("click", function () {

                // Pre-select previously chosen categories
                const selected = document.getElementById("selectedCategories").value;
                if (selected) {
                    selected.split(",").forEach(val => {
                        const checkbox = document.querySelector(
                            `.category-checkbox[value="${val}"]`
                        );
                        if (checkbox) checkbox.checked = true;
                    });
                }

                categoryModal.show();
            });

        // Handle Apply
        document.getElementById("categoryModalForm")
            .addEventListener("submit", function (e) {
                e.preventDefault();

                const selected = [];
                document
                    .querySelectorAll(".category-checkbox:checked")
                    .forEach(cb => selected.push(cb.value));

                document.getElementById("selectedCategories").value = selected.join(",");
                document.getElementById("selectedCategoriesText").innerText =
                    selected.length ? selected.join(", ") : "No categories selected";

                categoryModal.hide();
            });
    });

    $(function () {

        // Pre-select previously selected categories
    let selected = $("#selectedCategories").val();
    if (selected) {
        selected.split(",").forEach(function (val) {
            $(".category-checkbox[value='" + val + "']").prop("checked", true);
        });
    }

    $("#categoryModalForm").submit(function (e) {
        e.preventDefault();

        let selectedValues = [];
        $(".category-checkbox:checked").each(function () {
            selectedValues.push($(this).val());
        });

        updateSelectedCategories(selectedValues);
    });


        function updateSelectedText() {
            let selected = [];

            $('.category-checkbox:checked').each(function () {
                selected.push($(this).val());
            });
            $('#selectedCategoriesText').text(
                selected.length > 0
                    ? selected.join(", ")
                    : "No categories selected"
            );
            return selected;
        }

        function loadProducts(selectedCategories) {
            $.ajax({
                url: '@Url.Action("ProductsByCategories", "Customer")',
                data: { categories: selectedCategories },
                traditional: true, // allows sending array in query
                type: "GET",
                success: function (partialResult) {
                    $('#productContainer').html(partialResult);
                },
                error: function () {
                    $('#productContainer').html(
                        '<div class="alert alert-danger text-center">Failed to load products.</div>'
                    );
                }
            });


        }

        $('.category-checkbox').change(function () {
            const selected = updateSelectedText();

            // If nothing selected → clear product area
            if (selected.length === 0) {
                $('#productContainer').html('');
                $('#selectedCategoriesText').text();
                return;
            }

            // Load products
            //loadProducts(selected);
        });

        $("#openCategoryModal").click(function () {
        $.get("/Customer/GetCategotiesByLocation", function (data) {
            $("#categoryModalBody").html(data);
            $("#categoryModal").modal("show");
        });
    });

    function updateSelectedCategories(categories) {
        $("#selectedCategories").val(categories.join(","));

        $("#selectedCategoriesText").text(
            categories.length > 0
                ? categories.join(", ")
                : "No categories selected"
        );
        loadProducts(document.getElementById("selectedCategoriesText").innerText);
        $("#categoryModal").modal("hide");
    }
    });
</script>


