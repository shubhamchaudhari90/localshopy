@model IEnumerable<Categoty>

<div class="pt-4 pb-3">

    <!-- Row: location left + category dropdown right -->
    <div class="d-flex justify-content-between align-items-center mb-2">

        <!-- Left: Change Location -->
        <div class="text-start">
            <button type="button" class="btn btn-warning" id="openCategoryModal">
                Select Categories
            </button>

        </div>


        <!-- Open Popup Button -->
        <div class="text-end">
            <a asp-controller="Customer" asp-action="ChangeLocation"
               class="btn btn-outline-warning btn-sm">
                <i class="bi bi-geo-alt"></i> Change Location
            </a>
        </div>

        <!-- Hidden input -->
        <input type="hidden" id="selectedCategories" />

        <!-- Selected categories text -->
        <div class="mt-2 text-end fw-semibold visually-hidden">
            <span id="selectedCategoriesText">No categories selected</span>
        </div>

        <!-- Modal -->
        <div class="modal fade" id="categoryModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-scrollable modal-sm modal-dialog-centered">
                <div class="modal-content border-0 shadow">

                    <!-- Header -->
                    <div class="modal-header bg-warning text-dark">
                        <h5 class="modal-title fw-bold">
                            Select Categories
                        </h5>
                        <button type="button" class="btn-close"
                                data-bs-dismiss="modal"></button>
                    </div>

                    <!-- Body -->
                    <div class="modal-body alert alert-warning mb-0 rounded-0">

                        <form id="categoryModalForm">

                            <div class="mb-3">
                                <span class="fw-semibold d-block">
                                    Choose one or more categories
                                </span>
                                <small class="text-muted">
                                    Up to 7 categories allowed
                                </small>
                            </div>


                            <div class="row g-2 mb-3">
                                @foreach (var cat in Model)
                                {
                                    <div class="col-6 col-lg-12">
                                        <label class="list-group-item bg-transparent border-0 px-0 d-flex align-items-center">
                                            <input class="form-check-input me-2 category-checkbox"
                                                   type="checkbox"
                                                   value="@cat.Name"
                                                   id="modal_cat_@cat.Name" />
                                            <span class="fw-semibold">@cat.Name</span>
                                        </label>
                                    </div>
                                }
                            </div>


                            <div class="d-grid">
                                <button id="btnApply"
                                        type="submit"
                                        class="btn btn-warning btn-lg fw-bold rounded-pill">
                                    Apply & Close
                                </button>
                            </div>

                        </form>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>

<div id="productContainer">
    <!-- Products will be loaded here -->
    <div class="card border-warning shadow-sm text-center"><div class="card-body alert alert-warning mb-0 rounded"><div class="mb-3"><i class="bi bi-exclamation-circle fs-1 text-warning"></i></div><h5 class="fw-bold text-dark">Please select categories to see available products.</h5></div></div>
</div>

<script>
    $(document).ready(function () {

        const maxSelection = 7;

        // Open category modal
        $("#openCategoryModal").click(function () {
            $.get("/Customer/GetCategotiesByLocation", function (data) {
                $("#categoryModalBody").html(data);

                // Pre-select previously chosen categories
                preselectCategories();

                // Enforce selection limit
                updateCheckboxLimit();

                // Bind change event
                bindCheckboxChange();

                // Show modal
                $("#categoryModal").modal("show");
            });
        });

        // Apply selected categories
        $("#categoryModalForm").on("submit", function (e) {
            e.preventDefault();
            updateSelectedCategories();
        });

        // -------------------------------
        // Functions
        // -------------------------------

        // Pre-select previously chosen categories
        function preselectCategories() {
            const selected = $("#selectedCategories").val();
            if (selected) {
                selected.split(",").forEach(function (val) {
                    $(".category-checkbox[value='" + val + "']").prop("checked", true);
                });
            }
        }

        // Enforce max selection limit
        function updateCheckboxLimit() {
            const checkedCount = $(".category-checkbox:checked").length;
            const allCheckboxes = $(".category-checkbox");

            if (checkedCount >= maxSelection) {
                allCheckboxes.not(":checked").prop("disabled", true);
                $("#categoryLimitWarning").removeClass("d-none");
            } else {
                allCheckboxes.prop("disabled", false);
                $("#categoryLimitWarning").addClass("d-none");
            }
        }

        // Update selected categories (hidden input + text + load products)
        function updateSelectedCategories() {
            const selectedValues = $(".category-checkbox:checked")
                .map(function () { return $(this).val(); })
                .get(); // array of selected values

            // Update hidden input
            $("#selectedCategories").val(selectedValues.join(","));

            // Update text display
            $("#selectedCategoriesText").text(
                selectedValues.length > 0 ? selectedValues.join(", ") : ""
            );

            // Load products
            loadProducts(selectedValues);

            // Hide modal
            $("#categoryModal").modal("hide");
        }

        // Load products via AJAX
        function loadProducts(selectedCategories) {
            if (!selectedCategories || selectedCategories.length === 0) {
                $('#productContainer').html(
                    '<div class="card border-warning shadow-sm text-center">' +
                    '<div class="card-body alert alert-warning mb-0 rounded">' +
                    '<div class="mb-3"><i class="bi bi-exclamation-circle fs-1 text-warning"></i></div>' +
                    '<h5 class="fw-bold text-dark">No Products Found</h5>' +
                    '<p class="text-muted mb-0">Please select categories to see available products.</p>' +
                    '</div></div>'
                );
                return;
            }
            console.log(document.getElementById("selectedCategoriesText").innerText);
            $.ajax({
                url: '@Url.Action("ProductsByCategories", "Customer")',
                type: "GET",
                data: { categories: document.getElementById("selectedCategoriesText").innerText },
                traditional: true, // important for sending arrays
                success: function (partialResult) {
                    $("#productContainer").html(partialResult);
                },
                error: function () {
                    $('#productContainer').html(
                        '<div class="card border-warning shadow-sm text-center">' +
                        '<div class="card-body alert alert-warning mb-0 rounded">' +
                        '<div class="mb-3"><i class="bi bi-exclamation-circle fs-1 text-warning"></i></div>' +
                        '<h5 class="fw-bold text-dark">No Products Found</h5>' +
                        '<p class="text-muted mb-0">Please select categories to see available products.</p>' +
                        '</div></div>'
                    );
                }
            });
        }

        // Bind checkbox change event
           function bindCheckboxChange() {
        $(".category-checkbox").off("change").on("change", function () {
            // Get all selected checkbox values as an array
            const selected = $(".category-checkbox:checked")
                .map(function () { return $(this).val(); })
                .get();

                console.log("ABC");
                console.log(selected);
            // Convert array to a readable string (comma + space)
            const selectedText = selected.length > 0 ? selected.join(", ") : "None";
            console.log("DEF");
            console.log(selected);
            // Update UI display
            $("#selectedCategoriesText").text(selectedText);

            // Update hidden input for form submission or ajax
            $("#selectedCategories").val(selected.join(","));

            // Enforce selection limit (disable extra checkboxes if max reached)
            updateCheckboxLimit();

            // Dynamically load products based on selected categories
            loadProducts(selected);
        });
    }


        // Initial page load: preselect & enforce limit if hidden input has values
        preselectCategories();
        updateCheckboxLimit();
        bindCheckboxChange();

    });
</script>


