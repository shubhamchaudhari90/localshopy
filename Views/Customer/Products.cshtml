@model IEnumerable<Categoty>

<div class="pt-4 pb-3">

    <!-- Row: location left + category dropdown right -->
    <div class="d-flex justify-content-between align-items-center mb-2">

        <!-- Left: Change Location -->
        <div class="text-start">
            <a asp-controller="Customer" asp-action="ChangeLocation"
               class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-geo-alt"></i> Change Location
            </a>
        </div>

        <!-- Right: Category dropdown -->
        <div class="text-end">
            <div class="dropdown">
                <button class="btn btn-warning dropdown-toggle" type="button" id="categoryMultiSelect"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    Select Categories
                </button>
                <ul class="dropdown-menu p-3" aria-labelledby="categoryMultiSelect"
                    style="max-height: 300px; overflow-y: auto;">
                    @foreach (var cat in Model)
                    {
                        <li class="form-check">
                            <input class="form-check-input category-checkbox" type="checkbox"
                                   value="@cat.Name" id="cat_@cat.Name" />
                            <label class="form-check-label" for="cat_@cat.Name">
                                @cat.Name
                            </label>
                        </li>
                    }
                </ul>
            </div>
        </div>

    </div>

    <!-- Line below: selected categories centered -->
    <div id="selectedCategoriesText" class="text-center fw-semibold mt-2">
        No categories selected
    </div>

</div>


<div id="productContainer">
    <!-- Products will be loaded here -->
</div>
<script>
    $(function () {

        function updateSelectedText() {
            let selected = [];

            $('.category-checkbox:checked').each(function () {
                selected.push($(this).val());
            });
            $('#selectedCategoriesText').text(
                selected.length > 0
                    ? selected.join(", ")
                    : "No categories selected"
            );
            return selected;
        }

        function loadProducts(selectedCategories) {
            $.ajax({
                url: '@Url.Action("ProductsByCategories", "Customer")',
                data: { categories: selectedCategories.join(",") },
                traditional: true, // allows sending array in query
                type: "GET",
                success: function (partialResult) {
                    $('#productContainer').html(partialResult);
                },
                error: function () {
                    $('#productContainer').html(
                        '<div class="alert alert-danger text-center">Failed to load products.</div>'
                    );
                }
            });


        }

        $('.category-checkbox').change(function () {
            const selected = updateSelectedText();

            // If nothing selected → clear product area
            if (selected.length === 0) {
                $('#productContainer').html('');
                $('#selectedCategoriesText').text();
                return;
            }

            // Load products
            loadProducts(selected);
        });
    });
</script>

