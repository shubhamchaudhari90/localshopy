@using localshopyNew.ViewModel
@model IEnumerable<ProductViewModel>

@{
    var groupedProducts = Model
        .GroupBy(p => p.CategoryName ?? "Other")
        .OrderBy(g => g.Key);
}

<!-- 🔍 Search + Toggle -->
<div class="pt-4 pb-3 d-flex gap-2 align-items-center">
    <div class="position-relative flex-grow-1">
        <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
        <input id="productSearch"
               class="form-control form-control-lg ps-5 shadow-sm border-0"
               placeholder="Search by product or category..."
               autocomplete="off" />
    </div>

    <button id="toggleAccordionBtn"
            class="btn btn-outline-secondary btn-sm">
        Expand All
    </button>

</div>

@if (!groupedProducts.Any())
{
    <div class="alert alert-info text-center">
        No products available.
    </div>
}
else
{
    <div class="accordion" id="categoryAccordion">

        @foreach (var item in groupedProducts.Select((group, index) => new { group, index }))
        {
            var group = item.group;
            var index = item.index;

            var categoryId = $"category-{index}";
            var headingId = $"heading-{index}";
            var itemCount = group.Count();

            <div class="accordion-item mb-3"
                 data-category="@group.Key.ToLower()">

                <h2 class="accordion-header" id="@headingId">
                    <button class="accordion-button collapsed fw-semibold text-dark"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#@categoryId"
                            aria-expanded="false"
                            style="background-color:#ffc107;">
                        <span>@group.Key</span>
                        <span class="ms-1">
                            (<span class="category-count">@itemCount</span>)
                        </span>
                    </button>
                </h2>

                <div id="@categoryId"
                     class="accordion-collapse collapse"
                     aria-labelledby="@headingId">

                    <div class="accordion-body alert alert-warning">
                        <div class="row g-3">

                            @foreach (var product in group)
                            {
                                bool discountActive =
                                product.Discount > 0 &&
                                product.DiscountValidFrom.HasValue &&
                                product.DiscountValidTill.HasValue &&
                                DateTime.Today >= product.DiscountValidFrom.Value.Date &&
                                DateTime.Today <= product.DiscountValidTill.Value.Date;

                                string cardClass = product.IsAvailable
                                ? ""
                                : "border-secondary bg-secondary bg-opacity-10";

                                <div class="col-6 col-md-4 col-lg-3 product-card"
                                     data-product="@product.ProductMasterName.ToLower()">

                                    <div class="card h-100 shadow-sm @cardClass">
                                        <div class="row g-0 h-100">

                                            <div class="col-5 p-2">
                                                @if (!string.IsNullOrEmpty(product.ImageFileName))
                                                {
                                                    <img src="~/images/products/@product.ImageFileName"
                                                         class="rounded"
                                                         style="width:80px;height:80px;object-fit:cover;" />
                                                }
                                                else
                                                {
                                                    <div class="d-flex align-items-center justify-content-center bg-light text-muted rounded"
                                                         style="width:80px;height:80px;">
                                                        <i class="bi bi-image fs-3"></i>
                                                    </div>
                                                }
                                            </div>

                                            <div class="col-7 d-flex flex-column p-2">
                                                <div class="d-flex justify-content-between">
                                                    <span class="fs-6 fw-medium text-secondary">
                                                        @product.ShopName
                                                    </span>
                                                </div>
                                                <div class="d-flex justify-content-between">
                                                    <span class="fs-6 fw-medium text-secondary">
                                                        @product.Type
                                                    </span>
                                                </div>

                                                <!-- Type Icon -->
                                                <div class="d-inline-flex align-items-center justify-content-center"
                                                     style="
                                width:18px;
                                height:18px;
                                border:2px solid @(product.Type == "Veg" ? "var(--bs-success)" : product.Type == "Egg" ? "var(--bs-warning)" : "var(--bs-danger)");
                                border-radius:6px;
                                background-color:white;">

                                                    <!-- Inner Circle -->
                                                    <div style="
                                width:10px;
                                height:10px;
                                border-radius:50%;
                                background-color:@(product.Type == "Veg" ? "var(--bs-success)" : product.Type == "Egg" ? "var(--bs-warning)" : "var(--bs-danger)");">
                                                    </div>
                                                </div>


                                                <div class="d-flex justify-content-between mt-1">
                                                    <span class="fw-bold text-body">
                                                        @product.ProductMasterName
                                                    </span>
                                                </div>

                                                <div class="mt-auto d-flex justify-content-between align-items-center">
                                                    <div>
                                                        @if (discountActive)
                                                        {
                                                            <span class="small text-muted text-decoration-line-through">
                                                                ₹@product.Price
                                                            </span>
                                                        }
                                                        <span class="fw-bold text-success ms-1">
                                                            ₹@product.FinalPrice
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>

                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- 🧠 SCRIPT -->
<script>
    const searchInput = document.getElementById("productSearch");
    const accordionItems = document.querySelectorAll(".accordion-item");
    const toggleBtn = document.getElementById("toggleAccordionBtn");

    function expandAll() {
        accordionItems.forEach(item => {
            if (item.style.display === "none") return;
            const c = item.querySelector(".accordion-collapse");
            const b = item.querySelector(".accordion-button");
            c.classList.add("show");
            b.classList.remove("collapsed");
            b.setAttribute("aria-expanded", "true");
        });
        toggleBtn.textContent = "Collapse All";
        toggleBtn.dataset.state = "expanded";
    }

    function collapseAll() {
        accordionItems.forEach(item => {
            const c = item.querySelector(".accordion-collapse");
            const b = item.querySelector(".accordion-button");
            c.classList.remove("show");
            b.classList.add("collapsed");
            b.setAttribute("aria-expanded", "false");
        });
        toggleBtn.textContent = "Expand All";
        toggleBtn.dataset.state = "collapsed";
    }

    function updateButtonState() {
        const anyOpen = [...accordionItems]
            .some(i => i.querySelector(".accordion-collapse").classList.contains("show"));

        toggleBtn.textContent = anyOpen ? "Collapse All" : "Expand All";
        toggleBtn.dataset.state = anyOpen ? "expanded" : "collapsed";
    }

    toggleBtn.onclick = () =>
        toggleBtn.dataset.state === "expanded" ? collapseAll() : expandAll();

    accordionItems.forEach(item => {
        const c = item.querySelector(".accordion-collapse");
        c.addEventListener("shown.bs.collapse", updateButtonState);
        c.addEventListener("hidden.bs.collapse", updateButtonState);
    });

    searchInput.addEventListener("input", function () {
        const text = this.value.toLowerCase().trim();

        accordionItems.forEach(item => {
            const category = item.dataset.category;
            const products = item.querySelectorAll(".product-card");
            const count = item.querySelector(".category-count");

            let matched = 0;
            let catMatch = category.includes(text);

            products.forEach(p => {
                const match = p.dataset.product.includes(text);
                p.style.display = (text === "" || match || catMatch) ? "" : "none";
                if (match || (catMatch && text !== "")) matched++;
            });

            item.style.display = (text === "" || catMatch || matched > 0) ? "" : "none";
            count.textContent = text === "" ? products.length : matched;

            if (text !== "" && item.style.display !== "none") {
                item.querySelector(".accordion-collapse").classList.add("show");
            }
        });

        if (text === "") collapseAll();
        updateButtonState();
    });

    // 🔹 Initial state: expand everything
    document.addEventListener("DOMContentLoaded", () => {
        expandAll();
    });
</script>

