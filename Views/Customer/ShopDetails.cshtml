@using localshopyNew.ViewModel
@model ShopProductsViewModel

@{
    ViewData["Title"] = Model.Shop.Name ?? "Shop Details";
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="card shadow-sm animate__animated animate__fadeInUp w-100" style="max-width: 1100px;">
        <div class="card-body p-4">

            <!-- Header -->
            <div class="text-center mb-4">
                <!-- Shop Name -->
                <div class="animate__animated animate__fadeInDown fw-bold"
                     style="font-size: 2.2rem; line-height: 1.2;">
                    @Model.Shop.Name
                </div>
            </div>

            <!-- Shop Details -->
            <div class="row mb-4">

                <div class="col-md-6">
                    <p><strong>Phone:</strong> @Model.Shop.PhoneNo</p>
                </div>

                <div class="col-md-6">
                    <p>
                        <strong>Locations:</strong> @string.Join(" | ", Model.Locations)
                    </p>
                </div>
            </div>

            @if (ViewData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @ViewData["ErrorMessage"]
                </div>
            }

            <hr />

            <!-- Product Section Header -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0">Products</h4>
            </div>

            @if (!Model.Products.Any())
            {
                <div class="alert alert-info">
                    <strong>No products found.</strong>
                </div>
            }
            else
            {

                // Group products by category
                var groupedProducts = Model.Products
                .GroupBy(p => p.CategoryName)
                .OrderBy(g => g.Key); // optional: order by category name


                <div class="accordion" id="categoryAccordion">

                    @foreach (var group in groupedProducts)
                    {
                        var categoryId = "category-" + group.Key.Replace(" ", "-"); // unique ID
                        var itemCount = group.Count();

                        <div class="accordion-item mb-3">
                            <h2 class="accordion-header" id="@($"{categoryId}-heading")">
                                <button class="accordion-button text-dark fw-semibold"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@categoryId"
                                        aria-expanded="true"
                                        aria-controls="@categoryId"
                                        style="background-color: #ffc107;">
                                    <!-- Bootstrap warning color -->
                                    @group.Key (@itemCount)
                                </button>
                            </h2>


                            <div id="@categoryId" class="accordion-collapse collapse show" aria-labelledby="@($"{categoryId}-heading")" data-bs-parent="#categoryAccordion">
                                <div class="accordion-body alert alert-warning">
                                    <div class="row g-3">
                                        @foreach (var product in group)
                                        {
                                            bool discountActive =
                                            product.Discount > 0 &&
                                            product.DiscountValidFrom.HasValue &&
                                            product.DiscountValidTill.HasValue &&
                                            DateTime.Today >= product.DiscountValidFrom.Value.Date &&
                                            DateTime.Today <= product.DiscountValidTill.Value.Date;

                                            <div class="col-12 col-md-6 col-lg-4 product-card">
                                                <div class="card h-100 shadow-sm">
                                                    <div class="row g-0 h-100">

                                                        <!-- Image Left -->
                                                        <div class="col-auto p-2">

                                                            <div class="position-relative" style="width:100px; height:100px;">

                                                                <!-- Product Image -->
                                                                @if (!string.IsNullOrEmpty(product.ImageFileName))
                                                                {
                                                                    <img src="~/images/products/@product.ImageFileName"
                                                                         class="img-fluid rounded"
                                                                         style="width:100%; height:100%; object-fit:cover;" />
                                                                }
                                                                else
                                                                {
                                                                    <div class="d-flex align-items-center justify-content-center rounded bg-light text-muted"
                                                                         style="width:100%; height:100%;">
                                                                        <i class="bi bi-image" style="font-size:2rem;"></i>
                                                                    </div>
                                                                }

                                                            </div>
                                                        </div>

                                                        <!-- Content Right -->
                                                        <div class="col d-flex flex-column p-2">

                                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                                <h6 class="mb-0 small">@product.ProductMasterName</h6>
                                                                <span class="fw-semibold @(product.IsAvailable ? "text-success" : "text-danger") small">
                                                                    @(product.IsAvailable ? "" : "Out of stock")
                                                                </span>
                                                            </div>

                                                            <!-- Type Icon -->
                                                            <div class="d-inline-flex align-items-center justify-content-center"
                                                                 style="
                                            width:18px;
                                            height:18px;
                                                        border:2px solid @(product.Type == "Veg" ? "var(--bs-success)" : product.Type == "Egg" ? "var(--bs-warning)" : product.Type == "Non-Veg" ? "var(--bs-danger)" : "");
                                            border-radius:6px;
                                            background-color:white;">

                                                                <!-- Inner Circle -->
                                                                <div style="
                                            width:10px;
                                            height:10px;
                                            border-radius:50%;
                                                        background-color:@(product.Type == "Veg" ? "var(--bs-success)" : product.Type == "Egg" ? "var(--bs-warning)" : product.Type == "Non-Veg" ? "var(--bs-danger)" : "");">
                                                                </div>
                                                            </div>

                                                            <p class="mb-1 text-muted small">@product.Description</p>

                                                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                                                <div class="d-flex align-items-center gap-2">
                                                                    @if (discountActive)
                                                                    {
                                                                        <span class="text-muted text-decoration-line-through small">
                                                                            ₹@product.Price
                                                                        </span>
                                                                        <span class="text-warning fw-semibold small">
                                                                            (-@product.Discount%)
                                                                        </span>
                                                                    }
                                                                    <span class="fw-bold text-success">
                                                                        ₹@product.FinalPrice
                                                                    </span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- JS Filter -->
<script>
    function filterProducts(filter) {
        document.querySelectorAll('.product-card').forEach(card => {
            if (filter === 'all' || card.dataset.filter === filter) {
                card.style.display = '';
            } else {
                card.style.display = 'none';
            }
        });
    }
</script>
