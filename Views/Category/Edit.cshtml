@model Categoty
@{
    ViewData["Title"] = "Edit Category";
}

<div class="container mt-5">
    <h2 class="animate__animated animate__fadeInDown">Add Category</h2>

    <form asp-action="Create" class="animate__animated animate__fadeInUp">
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="SortOrder" class="form-label"></label>
            <input asp-for="SortOrder" class="form-control" />
        </div>
        <div class="mb-3 form-check">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">Active</label>
        </div>
        <button type="submit" class="btn btn-colorful">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
