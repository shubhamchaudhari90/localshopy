@model Location
@{
    ViewData["Title"] = "Delete Location";
}

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark fw-bold">
            <h2 class="mb-0 animate__animated animate__fadeInDown">Delete Location</h2>
        </div>

        <div class="card-body animate__animated animate__fadeInUp">

            <div class="alert alert-warning animate__animated animate__fadeIn">
                Are you sure you want to delete this location?
            </div>
            @if (ViewData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @ViewData["ErrorMessage"]
                </div>
            }
            <form asp-action="Delete" method="post" class="animate__animated animate__fadeInUp">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label class="form-label">Location Name</label>
                    <input class="form-control" value="@Model.Name" disabled />
                </div>

                <button type="submit" class="btn btn-danger">
                    Delete
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>
