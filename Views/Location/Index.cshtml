@model List<string>

<h2>Locations</h2>

<!-- CREATE -->
<form asp-action="Create" method="post" class="mb-3">
    <div class="input-group">
        <input name="locationName"
               class="form-control"
               placeholder="Enter location name"
               required />
        <button type="submit" class="btn btn-primary">Add</button>
    </div>
</form>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Location</th>
            <th style="width:260px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var location in Model)
        {
            var inputId = $"loc_{location.Replace(" ", "_")}";

            <tr>
                <td>
                    <form asp-action="Edit" method="post" class="d-flex align-items-center">
                        <input type="hidden" name="oldName" value="@location" />

                        <input id="@inputId"
                               name="newName"
                               value="@location"
                               class="form-control me-2"
                               readonly />

                        <button type="button"
                                class="btn btn-sm btn-warning me-2"
                                onclick="toggleEdit('@inputId', this, '@location')">
                            Edit
                        </button>

                        <button class="btn btn-sm btn-success">
                            Save
                        </button>
                    </form>
                </td>
                <td>
                    <a asp-action="Delete"
                       asp-route-name="@location"
                       class="btn btn-sm btn-danger"
                       onclick="return confirm('Delete this location?');">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    function toggleEdit(inputId, btn, originalValue) {
        const input = document.getElementById(inputId);

        if (input.hasAttribute('readonly')) {
            // Enable editing
            input.removeAttribute('readonly');
            input.focus();
            btn.textContent = 'Cancel';
            btn.classList.remove('btn-warning');
            btn.classList.add('btn-secondary');
        } else {
            // Cancel editing → restore original value
            input.value = originalValue;
            input.setAttribute('readonly', true);
            btn.textContent = 'Edit';
            btn.classList.remove('btn-secondary');
            btn.classList.add('btn-warning');
        }
    }
</script>
