@model IEnumerable<Location>
@{
    ViewData["Title"] = "Active Locations";
}

<div class="container mt-5">
    <h2 class="mb-4 animate__animated animate__fadeInDown">Locations</h2>
    <a class="btn mb-3 animate__animated animate__fadeInUp btn-orange" href="@Url.Action("Create")">Add New Location</a>
    <a class="btn mb-3 animate__animated animate__fadeInUp btn-neutral" href="@Url.Action("Deleted")">Show Removed Locations</a>
    @if (!Model.Any())
    {
        <!-- No data message -->
        <div class="alert alert-info animate__animated animate__fadeIn">
            <strong>No locations found.</strong><br />
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var cat in Model)
            {
                <div class="col">
                    <div class="card animate__animated animate__zoomIn">
                        <div class="card-body">
                            <h5 class="card-title">@cat.Name</h5>
                            <p class="card-text">Sort Order: @cat.SortOrder</p>
                            <p class="card-text">Status: @(cat.IsActive ? "Active" : "Inactive")</p>
                            <a class="btn mb-3 btn-orange-light" href="@Url.Action("Edit", new { id = cat.Id })">Edit</a>
                            <a class="btn mb-3 btn-danger-custom" href="@Url.Action("Delete", new { id = cat.Id })">Delete</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
