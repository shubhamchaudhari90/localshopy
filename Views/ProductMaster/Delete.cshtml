@model ProductMaster
@{
    ViewData["Title"] = "Delete Product";
}

<div class="container mt-5">
    <h2 class="text-danger animate__animated animate__fadeInDown">
        Delete Product
    </h2>

    <div class="alert alert-warning animate__animated animate__fadeIn">
        Are you sure you want to delete this product?
    </div>

    <form asp-action="Delete" method="post" class="animate__animated animate__fadeInUp">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label">Product Name</label>
            <input class="form-control" value="@Model.ProductName" disabled />
        </div>

        <button type="submit" class="btn btn-danger">
            Delete
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>
