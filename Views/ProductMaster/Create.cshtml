@model ProductMaster
@{
    ViewData["Title"] = "Add Product";
}

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark fw-bold">
            <h2 class="mb-0 animate__animated animate__fadeInDown">Add Product</h2>
        </div>

        <div class="card-body animate__animated animate__fadeInUp">
            @if (ViewData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @ViewData["ErrorMessage"]
                </div>
            }
            <form asp-action="Create" method="post" class="animate__animated animate__fadeInUp">
                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label">Category</label>
                    <select asp-for="CategoryId"
                            asp-items="ViewBag.CategoryList"
                            class="form-select">
                        <option value="">-- Select Category --</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="ProductName" class="form-label"></label>
                    <input asp-for="ProductName" class="form-control" />
                </div>
                <button type="submit" class="btn btn-warning">Save</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>