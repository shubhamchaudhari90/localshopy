<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap CSS (first) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

    <!-- Animate.css -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <!-- jQuery (before any custom JS that uses it) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Bootstrap JS Bundle (includes Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            /* Responsive font using clamp() */
            font-size: clamp(15px, 1.5vw, 16px);
        }

        main {
            flex: 1;
        }

        footer {
            background-color: #f8f9fa;
            padding: 1rem 0;
            border-top: 1px solid #dee2e6;
        }

        .navbar-custom {
            background: linear-gradient(90deg, #FFC107, #FFCA28);
        }



            .navbar-custom .navbar-brand,
            .navbar-custom .nav-link {
                color: #fff;
                font-weight: bold;
                /* Navbar font responsive without media query */
                font-size: clamp(14px, 1.2vw, 16px);
            }

                .navbar-custom .nav-link:hover {
                    text-decoration: underline;
                }

        /* Header tags responsive font */
        h1, h2, h3, h4, h5, h6 {
            font-size: clamp(1rem, 2vw, 2rem);
        }

        .mt-5 {
            margin-top: 1rem !important;
        }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom navbar-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand animate__animated animate__fadeInDown" asp-area="" asp-controller="Home" asp-action="Index">LocalShopy</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link animate__animated animate__fadeInUp" asp-area="" asp-controller="Location" asp-action="Index">Location</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link animate__animated animate__fadeInUp" asp-area="" asp-controller="Category" asp-action="Index">Category</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link animate__animated animate__fadeInUp" asp-area="" asp-controller="ProductMaster" asp-action="Index">Product Master</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link animate__animated animate__fadeInUp" asp-area="" asp-controller="Shop" asp-action="Index">Shops</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link animate__animated animate__fadeInUp" asp-area="" asp-controller="Shopkeeper" asp-action="ShopDetails">Shopkeeper</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link animate__animated animate__fadeInUp" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-shrink-0">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="footer text-muted">
        <div class="container">
            &copy; 2025 - localshopyNew - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    @RenderSection("Scripts", required: false)
</body>
</html>
