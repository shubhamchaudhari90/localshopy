<!DOCTYPE html>
<html lang="en">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <style>

        /* Primary Orange Buttons */
        .btn-orange {
            background-color: #FF8C42; /* main orange */
            color: white;
            border: none;
        }

            .btn-orange:hover {
                background-color: #FF7A1C; /* darker orange on hover */
                color: white;
            }

        /* Slightly lighter for secondary primary actions (Edit) */
        .btn-orange-light {
            background-color: #FFA65C;
            color: white;
            border: none;
        }

            .btn-orange-light:hover {
                background-color: #FF9440;
                color: white;
            }

        /* Neutral / Cancel / Back */
        .btn-neutral {
            background-color: #6c757d; /* Bootstrap secondary */
            color: white;
            border: none;
        }

            .btn-neutral:hover {
                background-color: #5a6268;
            }

        /* Success for safe actions like Restore */
        .btn-success-custom {
            background-color: #28a745; /* green */
            color: white;
            border: none;
        }

            .btn-success-custom:hover {
                background-color: #218838;
            }

        /* Delete / destructive action (Red) */
        .btn-danger-custom {
            background-color: #dc3545; /* red */
            color: white;
            border: none;
        }

            .btn-danger-custom:hover {
                background-color: #c82333;
            }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            margin: 0;
        }

        main {
            flex: 1;
        }

        footer {
            background-color: #f8f9fa;
            padding: 1rem 0;
            border-top: 1px solid #dee2e6;
        }

        .navbar-custom {
            background: linear-gradient(90deg, #ff6f61, #ffb347);
        }

            .navbar-custom .navbar-brand,
            .navbar-custom .nav-link {
                color: #fff;
                font-weight: bold;
            }

                .navbar-custom .nav-link:hover {
                    text-decoration: underline;
                }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom navbar-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand animate__animated animate__fadeInDown" asp-area="" asp-controller="Home" asp-action="Index">LocalShopy</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link animate__animated animate__fadeInUp" asp-area="" asp-controller="Location" asp-action="Index">Location</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link animate__animated animate__fadeInUp" asp-area="" asp-controller="Category" asp-action="Index">Category</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link animate__animated animate__fadeInUp" asp-area="" asp-controller="Category" asp-action="Index">Categories</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link animate__animated animate__fadeInUp" asp-area="" asp-controller="Shop" asp-action="Index">Shops</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link animate__animated animate__fadeInUp" asp-area="" asp-controller="Cart" asp-action="Index">Cart</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link animate__animated animate__fadeInUp" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>


    <main role="main" class="flex-shrink-0">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="footer text-muted">
        <div class="container">
            &copy; 2025 - localshopyNew - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    @RenderSection("Scripts", required: false)
</body>

</html>
