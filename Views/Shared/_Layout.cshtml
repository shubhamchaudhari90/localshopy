<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Site CSS (your custom styles) -->
    <link rel="stylesheet" href="~/css/site.css" />

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Animate.css (optional animations) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <!-- jQuery (needed before any scripts that use it) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Bootstrap JS Bundle (includes Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            /* Responsive font using clamp() */
            font-size: clamp(15px, 1.5vw, 16px);
        }

        main {
            flex: 1;
        }

        footer {
            background-color: #f8f9fa;
            padding: 1rem 0;
            border-top: 1px solid #dee2e6;
        }

        .navbar-custom {
            background: linear-gradient(90deg, #FFC107, #FFCA28);
        }



            .navbar-custom .navbar-brand,
            .navbar-custom .nav-link {
                color: #fff;
                font-weight: bold;
                /* Navbar font responsive without media query */
                font-size: clamp(14px, 1.2vw, 16px);
            }

                .navbar-custom .nav-link:hover {
                    text-decoration: underline;
                }

        /* Header tags responsive font */
        h1, h2, h3, h4, h5, h6 {
            font-size: clamp(1rem, 2vw, 2rem);
        }

        .mt-5 {
            margin-top: 1rem !important;
        }

        .accordion-item {
            border: none !important; /* remove default bootstrap border */
            box-shadow: none; /* optional, remove shadow if any */
        }

    </style>
</head>

<body>
    @using Microsoft.AspNetCore.Http
    @using localshopyNew.Constants
    @using System.Security.Claims

    <header>
        <nav class="navbar navbar-dark navbar-custom shadow-sm">
            <div class="container d-flex justify-content-between align-items-center">

                <!-- Left: Brand + Hamburger + Menu -->
                <div class="d-flex flex-column flex-lg-row align-items-center">

                    <!-- Brand + Hamburger (row on mobile, same on lg) -->
                    <div class="d-flex align-items-center">
                        <!-- Hamburger for mobile -->
                        <button class="btn btn-outline-light me-2 d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#mobileMenu" aria-controls="mobileMenu" aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>

                        <!-- Brand -->
                        <a class="navbar-brand mb-0" asp-controller="Customer" asp-action="Products">LocalShopy</a>
                    </div>

                    @if (User != null && User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <!-- Menu: collapsible on mobile, inline on lg+ -->
                        <div class="collapse d-lg-flex mt-2 mt-lg-0 ms-lg-3 align-items-center" id="mobileMenu">

                            <!-- Left nav items -->
                            <ul class="navbar-nav flex-column flex-lg-row gap-2 mb-0 align-items-center">
                                @if (User.IsInRole(RoleConstants.Shopkeeper))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-light" asp-controller="Shopkeeper" asp-action="ShopDetails">My Shop</a>
                                    </li>
                                }
                                @if (User.IsInRole(RoleConstants.Admin))
                                {
                                    <li class="nav-item"><a class="nav-link text-light" asp-controller="Review" asp-action="Index">Review</a></li>
                                    <li class="nav-item"><a class="nav-link text-light" asp-controller="Shop" asp-action="Index">All Shops</a></li>
                                    <li class="nav-item"><a class="nav-link text-light" asp-controller="ShopProduct" asp-action="ShopList">Shop Products</a></li>
                                    <li class="nav-item"><a class="nav-link text-light" asp-controller="ProductMaster" asp-action="Index">Product Master</a></li>
                                    <li class="nav-item"><a class="nav-link text-light" asp-controller="Category" asp-action="Index">Category</a></li>
                                    <li class="nav-item"><a class="nav-link text-light" asp-controller="Location" asp-action="Index">Location</a></li>
                                }
                            </ul>
                        </div>
                    }
                </div>

                <!-- Right: Login/Logout with Email -->
                <div class="d-flex align-items-center ms-auto">
                    @if (User != null && User.Identity != null && User.Identity.IsAuthenticated)
                    {

                        <a href="@Url.Action("Index", "Cart")" class="position-relative text-decoration-none">
                            <i class="bi bi-cart fs-4" style="font-size: calc(1.75rem + .3vw) !important;"></i>

                            <span id="spnCartCount" style="font-size: 150%; top: 25% !important;" class="position-absolute top-0 start-50 translate-middle
                                         badge">
                                @(Context.Session.GetInt32("CartCount") ?? 0)
                            </span>

                        </a>



                        <a class="nav-link text-light" asp-controller="Account" asp-action="Logout">Logout</a>
                    }
                    else
                    {
                        <!-- Login button -->
                        <form asp-controller="Account" asp-action="Login" method="get" class="d-inline">
                            <button type="submit" class="btn btn-warning btn-sm fw-bold text-white">
                                Login
                            </button>
                        </form>
                    }
                </div>

            </div>
        </nav>
    </header>


    <main role="main" class="flex-shrink-0 alert alert-warning ">
        <div class="container">
            @RenderBody()
        </div>
    </main>
    2
    <footer class="footer text-muted bg-light py- mt-auto">
        <div class="container text-center">
            &copy; @DateTime.Now.Year - localshopy
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    @RenderSection("Scripts", required: false)
</body>

</html>
