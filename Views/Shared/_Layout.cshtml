<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Zoomed-out viewport for mobile -->
    <meta name="viewport" content="width=device-width, initial-scale=0.75, maximum-scale=1">

    <!-- Bootstrap CSS (first) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

    <!-- Animate.css -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <!-- jQuery (before any custom JS that uses it) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Bootstrap JS Bundle (includes Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            /* Responsive font using clamp() */
            font-size: clamp(15px, 1.5vw, 16px);
        }

        main {
            flex: 1;
        }

        footer {
            background-color: #f8f9fa;
            padding: 1rem 0;
            border-top: 1px solid #dee2e6;
        }

        .navbar-custom {
            background: linear-gradient(90deg, #FFC107, #FFCA28);
        }



            .navbar-custom .navbar-brand,
            .navbar-custom .nav-link {
                color: #fff;
                font-weight: bold;
                /* Navbar font responsive without media query */
                font-size: clamp(14px, 1.2vw, 16px);
            }

                .navbar-custom .nav-link:hover {
                    text-decoration: underline;
                }

        /* Header tags responsive font */
        h1, h2, h3, h4, h5, h6 {
            font-size: clamp(1rem, 2vw, 2rem);
        }

        .mt-5 {
            margin-top: 1rem !important;
        }
    </style>
</head>

<body>
    @using Microsoft.AspNetCore.Http
    @{
        // Get the value from session
        var isShopkeeper = Context.Session.GetString("IsShopkeeper");
        var admin = Context.Session.GetString("admin");
    }
    <header>
        <nav class="navbar navbar-dark navbar-custom shadow-sm">
            <div class="container d-flex justify-content-between align-items-start">

                <!-- Left: Brand + Hamburger + Menu -->
                <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center">

                    <!-- Brand + Hamburger (row on mobile, same on lg) -->
                    <div class="d-flex align-items-center">
                        <!-- Hamburger for mobile -->
                        <button class="btn btn-outline-light me-2 d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#mobileMenu" aria-controls="mobileMenu" aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>

                        <!-- Brand -->
                        <a class="navbar-brand mb-0" asp-area="" asp-controller="Customer" asp-action="Products">LocalShopy</a>
                    </div>

                    <!-- Menu: collapsible on mobile, inline on lg+ -->
                    <div class="collapse d-lg-flex mt-2 mt-lg-0 ms-lg-3" id="mobileMenu">
                        <ul class="navbar-nav flex-column flex-lg-row gap-2 mb-0">
                            @if (string.IsNullOrEmpty(isShopkeeper))
                            {
                                <li class="nav-item"><a class="nav-link text-light" asp-area="" asp-controller="Shopkeeper" asp-action="ShopDetails">Shop</a></li>
                            }
                            @if (!string.IsNullOrEmpty(admin) && (admin.Contains("GmRQ3xcRqDQhfmfL") || (admin.Contains("3Yq0fQiu3oBrqZlPi6oCTijDtbWin2"))))
                                            {
                                <li class="nav-item"><a class="nav-link text-light" asp-area="" asp-controller="Location" asp-action="Index">Location</a></li>
                                <li class="nav-item"><a class="nav-link text-light" asp-area="" asp-controller="Category" asp-action="Index">Category</a></li>
                                <li class="nav-item"><a class="nav-link text-light" asp-area="" asp-controller="ProductMaster" asp-action="Index">Product Master</a></li>
                                <li class="nav-item"><a class="nav-link text-light" asp-area="" asp-controller="Shop" asp-action="Index">Shops</a></li>
                            }
                        </ul>
                    </div>

                </div>

                <!-- Right: Login/Logout always top-aligned -->
                <div class="d-flex align-items-start">


                    <div class="d-flex align-items-start">
                        @if (!string.IsNullOrEmpty(isShopkeeper) || !string.IsNullOrEmpty(admin))
                        {
                            <!-- Logout button -->
                            <form asp-area="" asp-controller="Shopkeeper" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-warning btn-sm">Logout</button>
                            </form>
                        }
                        else
                        {
                            <!-- Login button -->
                            <a class="btn btn-warning btn-sm" asp-area="" asp-controller="Shopkeeper" asp-action="Login">Login</a>
                        }
                    </div>

                </div>

            </div>
        </nav>
    </header>

    <main role="main" class="flex-shrink-0">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="footer text-muted bg-light py-2 mt-auto">
        <div class="container text-center">
            &copy; @DateTime.Now.Year - localshopy
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    @RenderSection("Scripts", required: false)
</body>
</html>
