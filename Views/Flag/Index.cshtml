@model IEnumerable<localshopyNew.Models.Flag>

@{
    ViewData["Title"] = "Application Flags";
}

<div class="container mt-5">

    <h2 class="mb-4 animate__animated animate__fadeInDown">
        Application Flags
    </h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success animate__animated animate__fadeIn">
            @TempData["Success"]
        </div>
    }

    @if (ViewData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger animate__animated animate__fadeIn">
            @ViewData["ErrorMessage"]
        </div>
    }

    <!-- Add / Update -->
    <div class="card shadow-sm mb-4 animate__animated animate__fadeInUp">

        <div class="card-header bg-dark text-white">
            Add / Update Flag
        </div>

        <div class="card-body">

            <form asp-action="Save" method="post">

                @Html.AntiForgeryToken()

                <div class="row">

                    <div class="col-md-5 mb-3">

                        <label class="form-label fw-bold">
                            Key
                        </label>

                        <input class="form-control"
                               name="Key"
                               placeholder="Enter Key"
                               maxlength="100"
                               required />

                    </div>

                    <div class="col-md-5 mb-3">

                        <label class="form-label fw-bold">
                            Value
                        </label>

                        <input class="form-control"
                               name="Value"
                               placeholder="Enter Value"
                               maxlength="500"
                               required />

                    </div>

                    <div class="col-md-2 d-grid mb-3">

                        <label class="form-label invisible">
                            Button
                        </label>

                        <button type="submit"
                                class="btn btn-warning">
                            Save
                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info animate__animated animate__fadeIn">
            <strong>No flags found.</strong>
        </div>
    }
    else
    {
        <div class="table-responsive animate__animated animate__fadeInUp">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">

                    <tr>
                        <th>#</th>
                        <th>Key</th>
                        <th>Value</th>
                        <th width="220" class="text-center">
                            Actions
                        </th>
                    </tr>

                </thead>

                <tbody>

                    @{
                        int sr = 1;
                    }

                    @foreach (var item in Model.OrderBy(x => x.Key))
                    {
                        <tr>

                            <td>@sr</td>

                            <td>
                                <strong>@item.Key</strong>
                            </td>

                            <td>@item.Value</td>

                            <td class="text-center">

                                <div class="d-flex justify-content-center gap-2">

                                    <button type="button"
                                            class="btn btn-sm btn-warning edit-btn"
                                            data-key="@item.Key"
                                            data-value="@item.Value">
                                        Edit
                                    </button>

                                    <form asp-action="Delete"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this flag?');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="key"
                                               value="@item.Key" />

                                        <button type="submit"
                                                class="btn btn-sm btn-danger">
                                            Delete
                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>

                        sr++;
                    }

                </tbody>

            </table>

        </div>
    }

</div>

@section Scripts
{
    <script>

        document.querySelectorAll(".edit-btn").forEach(function (button) {

            button.addEventListener("click", function () {

                document.querySelector("input[name='Key']").value =
                    this.dataset.key;

                document.querySelector("input[name='Value']").value =
                    this.dataset.value;

                document.querySelector("input[name='Key']").focus();

                window.scrollTo({
                    top: 0,
                    behavior: "smooth"
                });

            });

        });

        setTimeout(function () {

            document.querySelectorAll(".alert-success").forEach(function (a) {

                a.style.transition = "0.5s";
                a.style.opacity = "0";

                setTimeout(function () {
                    a.remove();
                }, 500);

            });

        }, 3000);

    </script>
}