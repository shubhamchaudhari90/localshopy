@model Product

@{
    ViewData["Title"] = "Edit Product";
}

<h2>Edit Product</h2>

<form asp-action="EditProduct" method="post" enctype="multipart/form-data">
    

    <div class="form-group mb-2">
        <label>Name</label>
        <input asp-for="Name" type="text" class="form-control" readonly/>
    </div>

    <div class="form-group mb-2">
        <label>Description</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="form-group mb-2">
        <label>Product Image</label>
        <input type="file" name="ProductImage" class="form-control" />
        @if (!string.IsNullOrEmpty(Model.ImageFileName))
        {
            <img src="~/images/products/@Model.ImageFileName" alt="Product Image" width="100" class="mt-2" />
        }
    </div>


    <div class="form-group mb-2">
        <label>Price</label>
        <input asp-for="Price" type="number" class="form-control" required />
    </div>

    @*    <div class="form-check mb-2">
        <input asp-for="IsAvailable" class="form-check-input" />
        <label asp-for="IsAvailable" class="form-check-label">Available</label>
    </div> *@

    <div class="form-group mb-3">
        <label class="form-label d-block">Product Availability</label>

        <div class="form-check form-switch">
            <input asp-for="IsAvailable"
                   class="form-check-input"
                   type="checkbox"
                   id="IsAvailableSwitch" />

            <label class="form-check-label" for="IsAvailableSwitch">
                <span id="availabilityText">
                    @(Model.IsAvailable ? "Available" : "Out Of Stock")
                </span>
            </label>
        </div>
    </div>


    <div class="form-group mb-2">
        <label>Discount (%)</label>
        <input asp-for="Discount" type="number" class="form-control" step="0.01" />
    </div>

    <div class="form-group mb-2">
        <label>Discount Valid From</label>
        <input asp-for="DiscountValidFrom" type="date" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Discount Valid Till</label>
        <input asp-for="DiscountValidTill" type="date" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary mt-2">Save Changes</button>
    <a asp-action="Products" class="btn btn-secondary mt-2">Cancel</a>
</form>

<div asp-validation-summary="All" class="text-danger"></div>
<script>
    const availabilitySwitch = document.getElementById('IsAvailableSwitch');
    const availabilityText = document.getElementById('availabilityText');

    if (availabilitySwitch) {
        availabilitySwitch.addEventListener('change', function () {
            availabilityText.textContent = this.checked
                ? 'Available'
                : 'Out Of Stock';
        });
    };
    

</script>
