@model Product
@{
    ViewData["Title"] = "Add Product";
}

<div class="container mt-5">

    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark fw-bold">
            <h2 class="mb-0 animate__animated animate__fadeInDown">Add Product</h2>
        </div>

        <div class="card-body animate__animated animate__fadeInUp">

            <form asp-action="AddProduct" method="post" enctype="multipart/form-data">

                @if (ViewData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">
                        @ViewData["ErrorMessage"]
                    </div>
                }

                <!-- Category Dropdown -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <label class="form-label mb-0">
                            Category <span class="text-danger">*</span>
                        </label>
                        <a asp-controller="Shopkeeper" asp-action="CategoryList"
                           class="text-warning fw-bold text-decoration-none">
                            View Catalog
                        </a>
                    </div>

                    <select id="ddlCategory" class="form-select" asp-items="ViewBag.Categories" required>
                        <option value="">-- Select Category --</option>
                    </select>
                </div>

                <!-- Product Master Dropdown -->
                <div class="mb-3">
                    <label asp-for="ProductMasterId" class="form-label">Product Name <span class="text-danger">*</span></label>
                    <select id="ddlProductMaster" asp-for="ProductMasterId" class="form-select" required>
                        <option value="">-- Select Product Master --</option>
                    </select>
                </div>

                <!-- Type Dropdown -->
                <div class="mb-3">
                    <label asp-for="Type" class="form-label">Type <span class="text-danger">*</span></label>
                    <select id="ddlType" asp-for="Type" class="form-select" required>
                        <option value="">-- Select Type --</option>
                        <option value="Veg">Veg</option>
                        <option value="Egg">Egg</option>
                        <option value="Non-Veg">Non-Veg</option>
                    </select>
                    <span asp-validation-for="Type" class="text-danger"></span>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description <span class="text-danger">*</span></label>
                    <input asp-for="Description" class="form-control" maxlength="150" required oninput="this.value = this.value.slice(0, 150);" />
                </div>

                <!-- Price -->
                <div class="mb-3">
                    <label asp-for="Price" class="form-label">Price (₹) <span class="text-danger">*</span></label>
                    <input asp-for="Price"
                           class="form-control"
                           id="txtPrice"
                           required
                           maxlength="5"
                           inputmode="numeric"
                           pattern="[0-9]+"
                           oninput="
                           this.value=this.value.replace(/[^0-9]/g, '' );
                           if (parseInt(this.value)> 10000) this.value = '10000';
                    " />

                </div>

                <!-- User-friendly IsAvailable toggle -->
                <div class="mb-3 form-check form-switch">
                    <input asp-for="IsAvailable" class="form-check-input" type="checkbox" id="isAvailableSwitch" onchange="updateStatusText()" />
                    <label class="form-check-label fw-semibold" id="isAvailableLabel" for="isAvailableSwitch">
                        @(Model.IsAvailable ? "Available" : "Out of stock")
                    </label>
                </div>

                <!-- Image -->
                <div class="mb-3">
                    <label asp-for="ProductImage" class="form-label">Product Image</label>
                    <input asp-for="ProductImage" type="file" class="form-control" />
                </div>

                <!-- Apply Discount Toggle -->
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" id="applyDiscountToggle" />
                    <label class="form-check-label fw-semibold" for="applyDiscountToggle">Apply Discount</label>
                </div>

                <!-- Discount Fields Container -->
                <div id="discountFields" style="display: none;">
                    <!-- Discount (%) -->
                    <div class="mb-3">
                        <label asp-for="Discount" class="form-label">Discount (%)</label>
                        <input asp-for="Discount"
                               class="form-control"
                               id="txtDiscount"
                               type="number"
                               min="0"
                               max="99"
                               step="1"
                               oninput="
                               if (this.value < 0) this.value = 0;
                        if (this.value > 99) this.value = 99;
                        this.value = this.value.replace(/[^0-9]/g, '');
                        " />

                        <span class="text-danger" id="discountError"></span>
                    </div>

                    <!-- Discount Valid From -->
                    <div class="mb-3">
                        <label asp-for="DiscountValidFrom" class="form-label">Discount Valid From</label>
                        <input asp-for="DiscountValidFrom" type="date" class="form-control" id="txtDiscountFrom" />
                        <span class="text-danger" id="fromError"></span>
                    </div>

                    <!-- Discount Valid Till -->
                    <div class="mb-3">
                        <label asp-for="DiscountValidTill" class="form-label">Discount Valid Till</label>
                        <input asp-for="DiscountValidTill" type="date" class="form-control" id="txtDiscountTill" />
                        <span class="text-danger" id="tillError"></span>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn  border-dark btn-warning">Save</button>
                    <a asp-action="ShopDetails" class="btn  border-dark btn-secondary">Cancel</a>
                </div>

            </form>
        </div>
    </div>
</div>

<script>
    function updateStatusText() {
        const checkbox = document.getElementById('isAvailableSwitch');
        const label = document.getElementById('isAvailableLabel');

        label.textContent = checkbox.checked ? 'Available' : 'Out of stock';
    }
    $(document).ready(function () {

        $('#ddlCategory').on('change', function () {

            var categoryId = $(this).val();
            var productDropdown = $('#ddlProductMaster');
            productDropdown.empty()
                .append('<option value="">-- Select Product Master --</option>');

            if (!categoryId) return;

            $.ajax({
                url: '@Url.Action("GetProductsByCategory", "Shopkeeper")',
                type: 'GET',
                data: { categoryId: categoryId },
                success: function (data) {
                    $.each(data, function (i, item) {
                        productDropdown.append(
                            `<option value="${item.id}">${item.productName}</option>`
                        );
                    });
                },
                error: function (err) {
                    alert('Unable to load product masters.');
                }
            });
        });

        // Show/hide discount fields
        $('#applyDiscountToggle').change(function () {
            if ($(this).is(':checked')) {
                $('#discountFields').slideDown();
            } else {
                $('#discountFields').slideUp();
                // Reset values
                $('#txtDiscount').val(0);
                $('#txtDiscountFrom').val('');
                $('#txtDiscountTill').val('');
                $('.text-danger').text('');
            }
        });

        // Form submit validation
        $('form').submit(function (e) {
            if ($('#applyDiscountToggle').is(':checked')) {
                let isValid = true;
                const discount = parseInt($('#txtDiscount').val());
                const fromDate = $('#txtDiscountFrom').val();
                const tillDate = $('#txtDiscountTill').val();
                const today = new Date().toISOString().split('T')[0];

                // Discount validation
                if (isNaN(discount) || discount < 0 || discount > 99) {
                    $('#discountError').text('Discount must be between 0 and 99.');
                    isValid = false;
                } else {
                    $('#discountError').text('');
                }

                // From date validation
                if (!fromDate || fromDate < today) {
                    $('#fromError').text('From date must be today or later.');
                    isValid = false;
                } else {
                    $('#fromError').text('');
                }

                // Till date validation
                if (!tillDate || tillDate < fromDate) {
                    $('#tillError').text('Till date must be same or after From date.');
                    isValid = false;
                } else {
                    $('#tillError').text('');
                }

                if (!isValid) {
                    e.preventDefault(); // stop form submit
                }
            }
        });
    });
</script>
