@model Product

@{
    ViewData["Title"] = "Add Product";
}

<h2>Add Product</h2>

<form asp-action="AddProduct" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="Name"></label>

        <select asp-for="Name"
                class="form-control"
                asp-items="@(new SelectList(ViewBag.Products))">
            <option value="">-- Select Product --</option>
        </select>

        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label>Description</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="form-group mb-2">
        <label>Product Image</label>
        <input type="file" name="ProductImage" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Price</label>
        <input asp-for="Price" type="number" class="form-control" required />
    </div>

    <div class="form-check mb-2">
        <input asp-for="IsAvailable" class="form-check-input" />
        <label asp-for="IsAvailable" class="form-check-label">Available</label>
    </div>

    <div class="form-group mb-2">
        <label>Discount (%)</label>
        <input asp-for="Discount" type="number" class="form-control" step="0.01" />
    </div>

    <div class="form-group mb-2">
        <label>Discount Valid From</label>
        <input asp-for="DiscountValidFrom" type="date" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Discount Valid Till</label>
        <input asp-for="DiscountValidTill" type="date" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary mt-2">Add Product</button>
    <a asp-action="Products" class="btn btn-secondary mt-2">Cancel</a>
</form>

<div asp-validation-summary="All" class="text-danger"></div>
