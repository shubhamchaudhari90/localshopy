@* @model Shop

@{
    ViewData["Title"] = "Shop Details";
}

<h2>Shop Details</h2>

<h4>Name: @Model.Name</h4>
@if (Model.IsOpen)
{
    <h4 style="background-color: blue; color: white; padding: 8px;">
        Shop is Open
    </h4>
}
else
{
    <h4 style="background-color: red; color: white; padding: 8px;">
        Shop is Closed
    </h4>
}

@{
    var daysLeft = (Model.AccountValidTill - DateTime.Now).TotalDays;

    string cssClass;
    string statusText;

    if (daysLeft > 10)
    {
        cssClass = "valid-ok";
        statusText = "Active";
    }
    else if (daysLeft > 5)
    {
        cssClass = "valid-warning";
        statusText = "Expiring Soon";
    }
    else if (daysLeft > 0)
    {
        cssClass = "valid-danger";
        statusText = "Urgent";
    }
    else
    {
        cssClass = "valid-expired";
        statusText = "Expired";
    }
}
<div class="validity-card @cssClass">
    <strong>Account Validity</strong><br />
    @Model.AccountValidTill.ToShortDateString()
    <span class="status-text">@statusText</span>
</div>

<h4>Phone No: @Model.PhoneNo</h4>

<h4>
    Served Location:
    @(Model.ServedLocations != null && Model.ServedLocations.Any()
        ? string.Join(" | ", Model.ServedLocations)
        : "N/A")
</h4>

<h3>Products</h3>
<p>
    <a asp-action="AddProduct" class="btn btn-success">Add New Product</a>
</p>

<p>
    <a asp-action="Edit" class="btn btn-success">Edit Shop Details</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Image</th>
            <th>Price</th>
            <th>Discount (%)</th>
            <th>Final Price</th>
            <th>Available</th>
            <th>Discount From</th>
            <th>Discount Till</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model.Products)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Description</td>
                <td>
                    @if (!string.IsNullOrEmpty(product.ImageFileName))
                    {
                        <img src="~/images/products/@product.ImageFileName" width="100" />
                    }
                </td>

                <td>@product.Price</td>
                <td>@product.Discount</td>
                <td>@product.FinalPrice</td>
                <td>@(product.IsAvailable ? "Yes" : "Out Of Stock")</td>
                <td>@product.DiscountValidFrom?.ToString("yyyy-MM-dd")</td>
                <td>@product.DiscountValidTill?.ToString("yyyy-MM-dd")</td>
                <td>
                    <a asp-action="EditProduct" asp-route-name="@product.Name" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="DeleteProduct" asp-route-name="@product.Name" class="btn btn-danger btn-sm"
                       onclick="return confirm('Are you sure you want to delete this product?');">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<style>
    .validity-card {
        padding: 12px 16px;
        border-radius: 8px;
        color: #fff;
        max-width: 280px;
    }

    .valid-ok {
        background-color: #0d6efd; /* blue */
    }

    .valid-warning {
        background-color: #fd7e14; /* orange */
    }

    .valid-danger {
        background-color: #dc3545; /* red */
    }

    .valid-expired {
        background-color: #000;
        color: #ff4d4d;
    }

    .status-text {
        float: right;
        font-weight: 600;
    }

</style> *@