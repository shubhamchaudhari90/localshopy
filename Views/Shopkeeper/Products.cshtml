@model List<Product>

@{
    ViewData["Title"] = "Products";
}

<h2>Products</h2>

<p>
    <a asp-action="AddProduct" class="btn btn-success">Add New Product</a>
</p>

<p>
    <a asp-action="Edit" class="btn btn-success">Edit Shop Details</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Image</th>
            <th>Price</th>
            <th>Discount (%)</th>
            <th>Final Price</th>
            <th>Available</th>
            <th>Discount From</th>
            <th>Discount Till</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Description</td>
                <td>
                    @if (!string.IsNullOrEmpty(product.ImageFileName))
                    {
                        <img src="~/images/products/@product.ImageFileName" width="100" />
                    }
                </td>

                <td>@product.Price</td>
                <td>@product.Discount</td>
                <td>@product.FinalPrice</td>
                <td>@(product.IsAvailable ? "Yes" : "Out Of Stock")</td>
                <td>@product.DiscountValidFrom?.ToString("yyyy-MM-dd")</td>
                <td>@product.DiscountValidTill?.ToString("yyyy-MM-dd")</td>
                <td>
                    <a asp-action="EditProduct" asp-route-name="@product.Name" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="DeleteProduct" asp-route-name="@product.Name" class="btn btn-danger btn-sm"
                       onclick="return confirm('Are you sure you want to delete this product?');">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
