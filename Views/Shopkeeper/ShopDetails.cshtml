@using localshopyNew.ViewModel
@model ShopProductsViewModel
@{
    var daysLeft = (Model.Shop.AccountValidTill.Date - DateTime.Today).Days;

    string shopAlertClass;
    string shopAlertText;

    if (daysLeft < 0)
    {
        shopAlertClass = "alert alert-danger d-inline-block py-1 px-2 mb-0 fw-bold";
        shopAlertText = " (Expired)";
    }
    else if (daysLeft <= 5)
    {
        shopAlertClass = "alert alert-warning d-inline-block py-1 px-2 mb-0 fw-bold";
        shopAlertText = $" ({daysLeft} day{(daysLeft > 1 ? "s" : "")} left)";
    }
    else
    {
        shopAlertClass = "d-inline-block py-1 px-2 mb-0 fw-bold";
        shopAlertText = "";
    }
}

@{
    ViewData["Title"] = Model.Shop.Name ?? "Shop Details";
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="card shadow-sm animate__animated animate__fadeInUp w-100" style="max-width: 1100px;">
        <div class="card-body p-4">

            <!-- Header -->
            <div class="text-center mb-4">
                <!-- Shop Name -->
                <div class="animate__animated animate__fadeInDown fw-bold"
                     style="font-size: 2.2rem; line-height: 1.2;">
                    @Model.Shop.Name
                </div>
            </div>

            <!-- Shop Details -->
            <div class="row mb-4">

                <div class="col-md-6 d-flex justify-content-between align-items-center">

                    <!-- Left: Status -->
                    <div class="d-flex align-items-center gap-1">
                        <strong>Status:</strong>
                        <span class="@(Model.Shop.IsOpen ? "text-success" : "text-danger") fw-bold d-flex align-items-center gap-1">
                            @(Model.Shop.IsOpen ? "Open" : "Closed")
                            @if (Model.Shop.IsOpen)
                            {
                                <i class="bi bi-unlock text-success" title="Shop Open"></i>
                            }
                            else
                            {
                                <i class="bi bi-lock-fill text-danger" title="Shop Closed"></i>
                            }
                        </span>
                    </div>

                    <!-- Right: Edit button -->
                    <a href="@Url.Action("Edit", "Shopkeeper")"
                       class="btn btn-sm btn-warning"
                       title="Edit Shop Details">
                        <i class="bi bi-pencil"></i>
                    </a>

                </div>

                <div class="col-md-6">
                    <p>
                        <strong>Valid Till:</strong>
                        <span class="@shopAlertClass">
                            @Model.Shop.AccountValidTill.ToString("dd-MMM-yyyy")
                            @shopAlertText
                        </span>
                    </p>
                </div>

                <div class="col-md-6">
                    <p><strong>Phone:</strong> @Model.Shop.PhoneNo</p>
                </div>

                <div class="col-md-6">
                    <p><strong>Email:</strong> @Model.Shop.OwnerEmailId</p>
                </div>

                <div class="col-md-6">
                    <p>
                        <strong>Locations:</strong> @string.Join(" | ", Model.Locations)
                    </p>
                </div>

                <div class="col-md-6">
                    <a asp-action="Edit"
                       class="text-warning fw-bold text-decoration-none">
                        Edit Shop Data
                    </a>
                </div>

            </div>

            @if (ViewData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @ViewData["ErrorMessage"]
                </div>
            }

            <hr />

            <!-- Product Section Header -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0">Products</h4>
                <a class="btn btn-warning btn-sm" href="@Url.Action("AddProduct", "Shopkeeper")">
                    Add Product
                </a>
            </div>

            @if (!Model.Products.Any())
            {
                <div class="alert alert-info">
                    <strong>No products found.</strong>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var product in Model.Products)
                    {
                        bool discountActive =
                        product.Discount > 0 &&
                        product.DiscountValidFrom.HasValue &&
                        product.DiscountValidTill.HasValue &&
                        DateTime.Today >= product.DiscountValidFrom.Value.Date &&
                        DateTime.Today <= product.DiscountValidTill.Value.Date;

                        daysLeft = product.DiscountValidTill.HasValue
                        ? (product.DiscountValidTill.Value.Date - DateTime.Today).Days
                        : int.MaxValue;

                        string productCardClass;
                        if (!product.IsAvailable)
                        {
                            productCardClass = "border-secondary bg-secondary bg-opacity-10";
                        }
                        else
                        {
                            productCardClass = "";
                        }

                        // Determine filter category
                        string validFilter =
                        !product.DiscountValidTill.HasValue ? "all" :
                        daysLeft < 0 ? "expired" :
                        daysLeft <= 5 ? "less5" :
                        "more5";
                        <div class="col-12 col-md-6 col-lg-4 product-card" data-filter="@validFilter">
                            <div class="card h-100 shadow-sm @productCardClass">
                                <div class="card-body d-flex flex-column">

                                    <!-- Product Header -->
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h6 class="mb-0">@product.ProductMasterName</h6>

                                        <span class="fw-semibold @(product.IsAvailable ? "text-success" : "text-dark")">
                                            @(product.IsAvailable ? "Available" : "Out of stock")
                                        </span>
                                    </div>


                                    <hr class="my-2" />

                                    <!-- Image -->
                                    @if (!string.IsNullOrEmpty(product.ImageFileName))
                                    {
                                        <img src="~/images/products/@product.ImageFileName"
                                             class="img-fluid rounded mb-2"
                                             style="height:140px; width:100%; object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-column align-items-center justify-content-center rounded mb-2 bg-light text-muted"
                                             style="height:140px; width:100%;">
                                            <i class="bi bi-image" style="font-size:2.5rem;"></i>
                                            <span class="small mt-1">No Image</span>
                                        </div>
                                    }


                                    <!-- Description -->
                                    <p class="mb-2 text-muted small">@product.Description</p>

                                    <div class="d-flex align-items-center justify-content-between">

                                        <!-- Left: Price Details -->
                                        <div class="d-flex align-items-center gap-2">
                                            @if (discountActive)
                                            {
                                                <span class="text-muted text-decoration-line-through small">
                                                    ₹@product.Price
                                                </span>

                                                <span class="text-warning fw-semibold small">
                                                    (-@product.Discount%)
                                                </span>
                                            }

                                            <span class="fw-bold fs-5 text-success">
                                                ₹@product.FinalPrice
                                            </span>
                                        </div>


                                        <!-- Right: Actions -->
                                        <div class="d-flex align-items-center gap-2">
                                            <a class="btn btn-sm btn-warning"
                                               href="@Url.Action("EditProduct", "Shopkeeper", new { productId = product.Id })"
                                               title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <form asp-action="Delete" asp-controller="Shopkeeper" method="post"
                                                  onsubmit="return confirm('Are you sure you want to delete this product?');"
                                                  class="m-0">
                                                <input type="hidden" name="productId" value="@product.Id" />
                                                <button type="submit"
                                                        class="btn btn-sm btn-danger"
                                                        title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>

                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- JS Filter -->
<script>
    function filterProducts(filter) {
        document.querySelectorAll('.product-card').forEach(card => {
            if (filter === 'all' || card.dataset.filter === filter) {
                card.style.display = '';
            } else {
                card.style.display = 'none';
            }
        });
    }
</script>
