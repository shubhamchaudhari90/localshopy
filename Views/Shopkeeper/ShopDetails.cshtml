@using localshopyNew.ViewModel
@model ShopProductsViewModel
@{
    var daysLeft = (Model.Shop.AccountValidTill.Date - DateTime.Today).Days;

    string shopAlertClass;
    string shopAlertText;

    if (daysLeft < 0)
    {
        shopAlertClass = "alert alert-danger d-inline-block py-1 px-2 mb-0 fw-bold";
        shopAlertText = " (Expired)";
    }
    else if (daysLeft <= 5)
    {
        shopAlertClass = "alert alert-warning d-inline-block py-1 px-2 mb-0 fw-bold";
        shopAlertText = $" ({daysLeft} day{(daysLeft > 1 ? "s" : "")} left)";
    }
    else
    {
        shopAlertClass = "d-inline-block py-1 px-2 mb-0 fw-bold";
        shopAlertText = "";
    }
}


<div class="container mt-5 d-flex justify-content-center">
    <div class="card shadow-sm animate__animated animate__fadeInUp w-100" style="max-width: 1100px;">
        <div class="card-body p-4">

            <!-- Header -->
            <div class="text-center mb-4">
                <!-- Shop Name -->
                <div class="animate__animated animate__fadeInDown fw-bold"
                     style="font-size: 2.2rem; line-height: 1.2;">
                    @Model.Shop.Name
                </div>
            </div>

            <!-- Shop Details -->
            <div class="row mb-4">

                <div class="col-md-6">
                    <p>
                        <strong>Status:</strong>
                        <span class="@(Model.Shop.IsOpen ? "text-success" : "text-danger") fw-bold me-1">
                            @(Model.Shop.IsOpen ? "Open" : "Closed")
                        </span>
                        @* <span class="status-pill @(Model.Shop.IsOpen ? "bg-success" : "bg-danger") me-1"></span> *@
                    </p>
                </div>

                <div class="col-md-6">
                    <p>
                        <strong>Valid Till:</strong>
                        <span class="@shopAlertClass">
                            @Model.Shop.AccountValidTill.ToString("dd-MMM-yyyy")
                            @shopAlertText
                        </span>
                    </p>
                </div>

                <div class="col-md-6">
                    <p><strong>Phone:</strong> @Model.Shop.PhoneNo</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Email:</strong> @Model.Shop.OwnerEmailId</p>

                </div>

                @* <div class="col-md-6">
                    <p>
                        <strong>Created On:</strong> @(Model.Shop.CreatedAt?.ToString("dd-MMM-yyyy") ?? "-")
                    </p>
                </div> *@

                <div class="col-md-6">
                    <p>
                        <strong>Locations:</strong> @string.Join(" | ", Model.Locations)
                    </p>
                </div>

                <div class="col-md-6">
                    <a asp-action="Edit"
                       class="text-warning fw-bold text-decoration-none">
                        Edit Shop Data
                    </a>
                </div>

            </div>

            @if (ViewData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @ViewData["ErrorMessage"]
                </div>
            }

            <hr />

            <!-- Product Section Header -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0">Products</h4>
                <a class="btn btn-warning btn-sm" href="@Url.Action("AddProduct", "Shopkeeper")">
                    Add Product
                </a>
            </div>

            @if (!Model.Products.Any())
            {
                <div class="alert alert-info">
                    <strong>No products found.</strong>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var product in Model.Products.OrderBy(x => x.SortOrder))
                    {
                        bool discountActive =
                        product.Discount > 0 &&
                        product.DiscountValidFrom.HasValue &&
                        product.DiscountValidTill.HasValue &&
                        DateTime.Today >= product.DiscountValidFrom.Value.Date &&
                        DateTime.Today <= product.DiscountValidTill.Value.Date;

                        daysLeft = product.DiscountValidTill.HasValue
                        ? (product.DiscountValidTill.Value.Date - DateTime.Today).Days
                        : int.MaxValue;

                        string productCardClass;
                        if (!product.IsAvailable)
                        {
                            productCardClass = "border-secondary bg-secondary bg-opacity-10";
                        }
                        else if (discountActive)
                        {
                            productCardClass = "border-warning bg-warning bg-opacity-10";
                        }
                        else
                        {
                            productCardClass = "border-success bg-success bg-opacity-10";
                        }

                        // Determine filter category
                        string validFilter =
                        !product.DiscountValidTill.HasValue ? "all" :
                        daysLeft < 0 ? "expired" :
                        daysLeft <= 5 ? "less5" :
                        "more5";
                        string countdownBadge = "";
                        if (daysLeft > 0 && daysLeft <= 3)
                        {
                            countdownBadge = $"{daysLeft} day{(daysLeft > 1 ? "s" : "")} left";
                        }

                        <div class="col-12 col-md-6 col-lg-4 product-card" data-filter="@validFilter">
                            <div class="card h-100 shadow-sm @productCardClass">
                                <div class="card-body d-flex flex-column">

                                    <!-- Product Header -->
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h6 class="mb-0">Product #@product.SortOrder</h6>
                                        <div class="d-flex gap-1 flex-wrap">
                                            <span class="badge @(product.IsAvailable ? "bg-success" : "bg-secondary")">
                                                @(product.IsAvailable ? "Available" : "Out")
                                            </span>

                                            @if (discountActive)
                                            {
                                                <span class="badge bg-warning text-dark">@product.Discount% OFF</span>
                                            }

                                            @if (!string.IsNullOrEmpty(countdownBadge))
                                            {
                                                <span class="badge bg-danger text-white">@countdownBadge</span>
                                            }
                                        </div>
                                    </div>

                                    <hr class="my-2" />

                                    <!-- Image -->
                                    @if (!string.IsNullOrEmpty(product.ImageFileName))
                                    {
                                        <img src="~/uploads/@product.ImageFileName"
                                             class="img-fluid rounded mb-2"
                                             style="max-height: 140px; object-fit: cover;" />
                                    }

                                    <!-- Details -->
                                    <p class="mb-1"><strong>Price:</strong> ₹@product.Price</p>

                                    @if (discountActive)
                                    {
                                        <p class="mb-1 text-success">
                                            <strong>Discount Till:</strong> @product.DiscountValidTill?.ToShortDateString()
                                        </p>
                                    }

                                    <p class="mb-2 text-muted small">@product.Description</p>

                                    <!-- Actions -->
                                    <div class="mt-auto d-flex gap-2">
                                        <a class="btn btn-sm btn-warning flex-fill" href="@Url.Action("Upsert", "Shopkeeper", new { id = product.Id })">
                                            Edit
                                        </a>
                                        <a class="btn btn-sm btn-danger flex-fill" href="@Url.Action("Delete", "Shopkeeper", new { id = product.Id })">
                                            Delete
                                        </a>
                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- JS Filter -->
<script>
    function filterProducts(filter) {
        document.querySelectorAll('.product-card').forEach(card => {
            if (filter === 'all' || card.dataset.filter === filter) {
                card.style.display = '';
            } else {
                card.style.display = 'none';
            }
        });
    }
</script>
