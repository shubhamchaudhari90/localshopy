@model Shop
@{
    ViewData["Title"] = "Edit Shop";
}

<div class="container mt-5">
    <h2 class="animate__animated animate__fadeInDown">Edit Shop</h2>

    <form asp-action="Edit" method="post" class="animate__animated animate__fadeInUp">
        @if (ViewData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                @ViewData["ErrorMessage"]
            </div>
        }
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" readonly disabled />
        </div>

        <div class="mb-3">
            <label asp-for="PhoneNo" class="form-label"></label>
            <input asp-for="PhoneNo" class="form-control" readonly disabled />
        </div>

        <div class="mb-3">
            <label asp-for="OwnerEmailId" class="form-label"></label>
            <input asp-for="OwnerEmailId" class="form-control" readonly disabled />
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">Password <span class="text-danger">*</span></label>
            <a href="javascript:void(0)"
               id="lnkEditPassword"
               class="ms-2 text-warning fw-bold text-decoration-none">
                Click Here
            </a>

            <input asp-for="Password"
                   id="txtPassword"
                   class="form-control mt-2" required
                   disabled />
        </div>

        <!-- User-friendly IsOpen toggle -->
        <div class="mb-3 form-check form-switch">
            <input asp-for="IsOpen"
                   class="form-check-input"
                   type="checkbox"
                   id="isOpenSwitch"
                   onchange="updateStatusText()" />

            <label class="form-check-label" id="isOpenLabel" for="isOpenSwitch">
                @(Model.IsOpen ? "Shop is Open" : "Shop is Close")
            </label>
        </div>

        <!-- Locations Multi-select checkboxes -->
        <div class="mb-3">
            <label class="form-label">Locations</label>
            <div class="border rounded p-3">
                @foreach (var location in ViewBag.LocationList)
                {
                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               name="ServedLocations"
                               value="@location.Value"
                               id="loc_@location.Value"
                               @(Model?.ServedLocations.Contains(Guid.Parse(location.Value)) == true ? "checked" : "") />

                        <label class="form-check-label" for="loc_@location.Value">
                            @location.Text
                        </label>
                    </div>
                }
            </div>
        </div>

        <button type="submit" class="btn btn-warning">Save</button>
        <a asp-action="ShopDetails" class="btn btn-secondary">Cancel</a>
    </form>
</div>

<script>
    function updateStatusText() {
        const checkbox = document.getElementById('isOpenSwitch');
        const label = document.getElementById('isOpenLabel');

        label.textContent = checkbox.checked
            ? 'Shop is Open'
            : 'Shop is Close';
    }

    // Run on page load to show correct status
    document.addEventListener('DOMContentLoaded', updateStatusText);

    let isEditingPassword = false;
    let oldPassword = "";

    document.getElementById("lnkEditPassword").addEventListener("click", function () {
        const passwordInput = document.getElementById("txtPassword");

        if (!isEditingPassword) {
            // Store old password
            oldPassword = passwordInput.value;

            // Enable editing
            passwordInput.disabled = false;
            passwordInput.removeAttribute("readonly");
            passwordInput.focus();

            // Update link text
            this.innerText = "Use Old Password";
        } else {
            // Revert to old password
            passwordInput.value = oldPassword;
            passwordInput.disabled = true;

            // Update link text back
            this.innerText = "Click Here";
        }

        isEditingPassword = !isEditingPassword;
    });
</script>
