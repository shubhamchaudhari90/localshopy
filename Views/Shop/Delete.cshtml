@model Shop
@{
    ViewData["Title"] = "Delete Shop";
}

<div class="container mt-5">
    <h2 class="animate__animated animate__fadeInDown">Delete Shop</h2>

    <div class="alert alert-danger animate__animated animate__fadeInUp">
        <strong>Warning:</strong> This action will permanently delete the shop.
    </div>
    @if (ViewData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @ViewData["ErrorMessage"]
        </div>
    }
    <form asp-action="DeleteConfirmed" method="post" class="animate__animated animate__fadeInUp">

        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label">Name</label>
            <input class="form-control" value="@Model.Name" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Phone Number</label>
            <input class="form-control" value="@Model.PhoneNo" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Owner Email</label>
            <input class="form-control" value="@Model.OwnerEmailId" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Password</label>
            <input class="form-control" value="@Model.Password" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Shop Status</label>
            <input class="form-control" value="@(Model.IsOpen ? "Open" : "Close")" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Account Valid Till</label>
            <input class="form-control" value="@Model.AccountValidTill.ToShortDateString()" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Locations</label>
            <div class="border rounded p-3">
                @foreach (var location in ViewBag.LocationList)
                {
                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               value="@location.Value"
                               id="loc_@location.Value"
                               @(Model?.ServedLocations.Contains(Guid.Parse(location.Value)) == true ? "checked" : "")
                               disabled />
                        <label class="form-check-label" for="loc_@location.Value">
                            @location.Text
                        </label>
                    </div>
                }
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>

    </form>
</div>
