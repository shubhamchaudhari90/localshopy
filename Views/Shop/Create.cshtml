@model localshopyNew.Models.Shop

<h2>Create Shop</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label>Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Phone No.</label>
        <textarea asp-for="PhoneNo" class="form-control"></textarea>
    </div>

    <div class="form-group">
        <label>Location</label>
        <textarea asp-for="Location" class="form-control"></textarea>
    </div>

    <div class="form-group">
        <label>Owner Email</label>
        <input asp-for="OwnerEmailId" type="email" class="form-control" />
        <span asp-validation-for="OwnerEmailId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Password</label>
        <input asp-for="Password" type="password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-2">Create Shop</button>
</form>

<div asp-validation-summary="All" class="text-danger"></div>
