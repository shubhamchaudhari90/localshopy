@model localshopyNew.Models.Shop

<h2>Create Shop</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label>Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Phone No.</label>
        <textarea asp-for="PhoneNo" class="form-control"></textarea>
    </div>

    <div class="form-group">
        <label class="form-label d-block">Select Locations</label>

        @foreach (var location in ViewBag.Locations as List<string>)
        {
            bool isChecked = Model?.ServedLocations?.Contains(location) == true;

            <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       name="ServedLocations"
                       value="@location"
                       id="loc_@location.Replace(" ", "_")"
                       @(isChecked ? "checked" : "") />

                <label class="form-check-label"
                       for="loc_@location.Replace(" ", "_")">
                    @location
                </label>
            </div>
        }
    </div>

    <div class="form-group">
        <label>Owner Email</label>
        <input asp-for="OwnerEmailId" type="email" class="form-control" />
        <span asp-validation-for="OwnerEmailId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Password</label>
        <input asp-for="Password" type="password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Valid Till</label>
        <input asp-for="AccountValidTill" type="date" class="form-control" />
        <span asp-validation-for="AccountValidTill" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-2">Create Shop</button>
</form>

<div asp-validation-summary="All" class="text-danger"></div>
