@model Shop
@{
    ViewData["Title"] = "Add Product";
}

<div class="container mt-5">
    <h2 class="animate__animated animate__fadeInDown">Add Product</h2>

    <form asp-action="Create" method="post" class="animate__animated animate__fadeInUp">

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="PhoneNo" class="form-label"></label>
            <input asp-for="PhoneNo" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="OwnerEmailId" class="form-label"></label>
            <input asp-for="OwnerEmailId" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="AccountValidTill" class="form-label"></label>
            <input asp-for="AccountValidTill" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Locations</label>

            <div class="border rounded p-3">
                @foreach (var location in ViewBag.LocationList)
                {
                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               name="LocationIds"
                               value="@location.Value"
                               id="loc_@location.Value"
                               @(Model?.ServedLocations.Contains(Guid.Parse(location.Value)) == true ? "checked" : "") />

                        <label class="form-check-label" for="loc_@location.Value">
                            @location.Text
                        </label>
                    </div>
                }

            </div>
        </div>

        <button type="submit" class="btn btn-warning">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
<script>
    function updateStatusText() {
        const checkbox = document.getElementById('isOpenSwitch');
        const label = document.getElementById('isOpenLabel');

        label.textContent = checkbox.checked
            ? 'Shop is Open'
            : 'Shop is Close';
    }

    // Run on page load (important for Edit view)
    document.addEventListener('DOMContentLoaded', updateStatusText);
</script>