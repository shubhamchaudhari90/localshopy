@model localshopyNew.Models.Shop

<h2>Edit Shop</h2>
<button type="button" id="UpdatePassword" class="btn btn-primary mt-2">Update Password</button>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Name" />

    <div class="form-group">
        <label>Name</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="form-group">
        <label class="form-label d-block">Select Locations</label>

        @foreach (var location in ViewBag.Locations as List<string>)
        {
            bool isChecked = Model?.ServedLocations?.Contains(location) == true;

            <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       name="ServedLocations"
                       value="@location"
                       id="loc_@location.Replace(" ", "_")"
                       @(isChecked ? "checked" : "") />

                <label class="form-check-label"
                       for="loc_@location.Replace(" ", "_")">
                    @location
                </label>
            </div>
        }
    </div>

    <div class="form-group">
        <label>Phone No.</label>
        <textarea asp-for="PhoneNo" class="form-control"></textarea>
    </div>

    <div class="form-group">
        <label>Owner Email</label>
        <input asp-for="OwnerEmailId" type="email" class="form-control" readonly />
    </div>

    <div class="form-group">
        <label>Password</label>
        <input asp-for="Password" type="text" class="form-control" readonly />
    </div>

    <div class="form-check">
        <input asp-for="IsOpen" class="form-check-input" />
        <label asp-for="IsOpen" class="form-check-label">Is Open</label>
    </div>

    <button type="submit" class="btn btn-primary mt-2">Save Changes</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Cancel</a>
</form>
<br />


<div asp-validation-summary="All" class="text-danger"></div>

<script>
    const input = document.getElementById('Password');
    const button = document.getElementById('UpdatePassword');

    // Store original password value
    const originalPassword = input.value;

    button.addEventListener('click', function () {
        if (input.hasAttribute('readonly')) {
            // Enable editing
            input.removeAttribute('readonly');
            input.focus();
            button.textContent = 'Old Password';
        } else {
            // Restore old password and lock field
            input.value = originalPassword;
            input.setAttribute('readonly', true);
            button.textContent = 'Edit Password';
        }
    });
</script>



