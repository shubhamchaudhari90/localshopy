@model Shop

@{
    ViewData["Title"] = "Edit Shop";
}

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark fw-bold">
            <h2 class="mb-0 animate__animated animate__fadeInDown">Edit Shop</h2>
        </div>

        <div class="card-body animate__animated animate__fadeInUp">

            <form asp-action="Edit" method="post">

                @if (ViewData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">
                        @ViewData["ErrorMessage"]
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="TagLine" class="form-label"></label>
                    <input asp-for="TagLine" class="form-control" />
                </div>

                @* <div class="mb-3">
                    <label asp-for="ShopDescription" class="form-label"></label>
                    <input asp-for="ShopDescription" class="form-control" />
                </div> *@

                <div class="mb-3">
                    <label asp-for="PhoneNo" class="form-label"></label>
                    <input asp-for="PhoneNo" class="form-control" maxlength="10" />
                </div>

                <div class="mb-3">
                    <label asp-for="AlternateNumber" class="form-label"></label>
                    <input asp-for="AlternateNumber" class="form-control" maxlength="10" />
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="OwnerEmailId" class="form-label"></label>
                    <input asp-for="OwnerEmailId" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>

                    <a href="javascript:void(0)"
                       id="lnkEditPassword"
                       class="ms-2 text-warning fw-bold text-decoration-none">
                        Click Here
                    </a>

                    <input asp-for="Password"
                           id="txtPassword"
                           class="form-control mt-2"
                           disabled />
                </div>

                <!-- Open / Close Switch -->
                <div class="mb-3 form-check form-switch">
                    <input asp-for="IsOpen"
                           class="form-check-input"
                           type="checkbox"
                           id="isOpenSwitch"
                           onchange="updateStatusText()" />

                    <label class="form-check-label"
                           id="isOpenLabel"
                           for="isOpenSwitch">
                        @(Model.IsOpen ? "Shop is Open" : "Shop is Close")
                    </label>
                </div>

                <div class="mb-3">
                    <label asp-for="AccountValidTill" class="form-label"></label>
                    <input asp-for="AccountValidTill"
                           type="date"
                           class="form-control" />
                </div>

                <!-- Locations -->
                <div class="mb-3">
                    <label class="form-label">Locations</label>

                    <div class="border rounded p-3">

                        @foreach (var location in ViewBag.LocationList)
                        {
                            bool isAllIndia =
                            location.Text.ToString().Trim().Equals(
                            "All India",
                            StringComparison.OrdinalIgnoreCase);

                            <div class="form-check">

                                <input class="form-check-input location-checkbox @(isAllIndia ? "all-india-checkbox" : "")"
                                       type="checkbox"
                                       name="ServedLocations"
                                       value="@location.Value"
                                       id="loc_@location.Value"
                                       @(Model?.ServedLocations.Contains(Guid.Parse(location.Value)) == true ? "checked" : "") />

                                <label class="form-check-label"
                                       for="loc_@location.Value">
                                    @location.Text
                                </label>

                            </div>
                        }

                    </div>
                </div>

                <button type="submit" class="btn btn-warning">
                    Save
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>
</div>

<script>

    function updateStatusText() {

        const checkbox = document.getElementById('isOpenSwitch');
        const label = document.getElementById('isOpenLabel');

        label.textContent = checkbox.checked
            ? 'Shop is Open'
            : 'Shop is Close';
    }

    document.addEventListener("DOMContentLoaded", function () {

        updateStatusText();

        // Password Edit Logic
        let isEditingPassword = false;
        let oldPassword = "";

        const editPasswordLink = document.getElementById("lnkEditPassword");
        const passwordInput = document.getElementById("txtPassword");

        if (editPasswordLink && passwordInput) {

            editPasswordLink.addEventListener("click", function () {

                if (!isEditingPassword) {

                    oldPassword = passwordInput.value;

                    passwordInput.disabled = false;
                    passwordInput.focus();

                    this.innerText = "Use Old Password";

                } else {

                    passwordInput.value = oldPassword;
                    passwordInput.disabled = true;

                    this.innerText = "Click Here";
                }

                isEditingPassword = !isEditingPassword;
            });
        }

        // All India Logic
        const allIndiaCheckbox =
            document.querySelector(".all-india-checkbox");

        const checkboxes =
            document.querySelectorAll(".location-checkbox");

        if (!allIndiaCheckbox)
            return;

        function toggleLocations() {

            if (allIndiaCheckbox.checked) {

                checkboxes.forEach(function (cb) {

                    if (cb !== allIndiaCheckbox) {

                        cb.checked = true;
                        cb.disabled = true;
                    }
                });

            } else {

                checkboxes.forEach(function (cb) {

                    if (cb !== allIndiaCheckbox) {

                        cb.disabled = false;
                    }
                });
            }
        }

        allIndiaCheckbox.addEventListener(
            "change",
            toggleLocations
        );

        // Initial Page Load
        toggleLocations();
    });

</script>