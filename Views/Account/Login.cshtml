@using localshopyNew.ViewModel
@model LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<style>
    /* Page background */
    body {
        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
    }

    /* Center the login area vertically and horizontally */
    .login-section {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 0;
    }

    /* Card appearance and consistent sizing */
    .login-card {
        border-radius: 1rem;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        height: 100%;
    }

        /* Make card body stretch so that buttons sit consistently at bottom on larger screens */
        .login-card .card-body {
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 1rem;
            padding: 1.5rem;
        }

            /* Alert inside card centered and compact */
            .login-card .card-body .info-alert {
                margin: 0;
                width: 100%;
            }

    /* Google button style */
    .btn-google {
        background: #db4437;
        color: white;
        border: none;
    }

        .btn-google:hover,
        .btn-google:focus {
            background: #c33d30;
            color: #fff;
        }

    /* Ensure good touch targets and consistent button sizing */
    .auth-btn {
        padding: 0.65rem 1rem;
        font-weight: 700;
    }

    }
</style>

<div class="container login-section">
    <div class="row justify-content-center g-4 align-items-stretch">

        <!-- Google Login -->
        <div class="col-12 col-md-10 col-lg-5">
            <div class="card login-card h-100">
                <div class="card-body d-flex flex-column align-items-center justify-content-center text-center">
                    <div class="alert alert-danger info-alert fw-bold rounded-3" role="alert">
                        Please log in to use cart and place an order.
                    </div>

                    <a asp-controller="Account" asp-action="GoogleLogin" class="btn btn-google auth-btn w-100 btn-lg shadow-sm mt-2">
                        <i class="bi bi-google me-2" aria-hidden="true"></i>
                        Continue with Google
                    </a>
                </div>
            </div>
        </div>

        <!-- Manual Login -->
        <div class="col-12 col-md-10 col-lg-5">
            <div class="card login-card h-100">
                <div class="card-body d-flex flex-column">
                    <h3 class="text-center text-warning fw-bold mb-2">Shopkeeper Login</h3>

                    @if (ViewData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            @ViewData["ErrorMessage"]
                        </div>
                    }

                    <form asp-action="Login" method="post" class="needs-validation d-flex flex-column flex-grow-1" novalidate>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control" placeholder="Enter your email" type="email" required />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password <span class="text-danger">*</span></label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" required />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mt-auto">
                            <button type="submit" class="btn btn-warning w-100 fw-bold border-dark shadow-sm auth-btn">Login</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Simple bootstrap-style validation handler to improve UX
        (function () {
            'use strict';
            var forms = document.querySelectorAll('.needs-validation');
            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>
}