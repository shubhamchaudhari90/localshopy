@using localshopyNew.ViewModel
@model LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<style>

    body {
        min-height: 100vh;
        background: linear-gradient(-45deg,#f3f4f6,#e0ecff,#fff8e6,#f7f2ff);
        background-size: 400% 400%;
        animation: bgMove 15s ease infinite;
        font-family: 'Segoe UI',sans-serif;
    }

    .login-section {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px 15px;
    }

    .login-card {
        border: none;
        border-radius: 25px;
        overflow: hidden;
        background: rgba(255,255,255,.88);
        backdrop-filter: blur(12px);
        box-shadow: 0 15px 45px rgba(0,0,0,.15);
        transition: .35s;
        animation: fadeInUp .8s ease;
    }

        .login-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 25px 55px rgba(0,0,0,.20);
        }

    .card-body {
        padding: 35px;
    }

    .login-icon {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: #fff3cd;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto;
        font-size: 42px;
        color: #ff9800;
        animation: float 3s ease-in-out infinite;
        box-shadow: 0 10px 25px rgba(255,193,7,.35);
    }

    .login-title {
        font-size: 32px;
        font-weight: 700;
        color: #ff9800;
    }

    .login-subtitle {
        color: #6c757d;
        font-size: 15px;
    }

    .info-alert {
        border-radius: 15px;
        animation: pulse 2s infinite;
    }

    .form-control {
        border-radius: 12px;
        height: 52px;
        border: 1px solid #dee2e6;
        transition: .3s;
    }

        .form-control:focus {
            border-color: #ffc107;
            box-shadow: 0 0 15px rgba(255,193,7,.35);
            transform: scale(1.02);
        }

    .input-group-text {
        background: white;
        border-right: none;
    }

    .form-control {
        border-left: none;
    }

    .auth-btn {
        height: 52px;
        border-radius: 12px;
        font-weight: 700;
        transition: .3s;
    }

    .btn-google {
        background: #db4437;
        color: white;
    }

        .btn-google:hover {
            background: #c23321;
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(219,68,55,.35);
        }

    .btn-warning:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 25px rgba(255,193,7,.45);
    }

    .divider {
        display: flex;
        align-items: center;
        text-align: center;
        color: #999;
        margin: 20px 0;
    }

        .divider::before,
        .divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid #ddd;
        }

        .divider:not(:empty)::before {
            margin-right: 10px;
        }

        .divider:not(:empty)::after {
            margin-left: 10px;
        }

</style>

<div class="container login-section">

    <div class="row justify-content-center g-4 w-100">

        <!-- Google Login -->

        <div class="col-lg-5 col-md-10">

            <div class="card login-card h-100">

                <div class="card-body text-center d-flex flex-column justify-content-center">

                    <div class="login-icon mb-4">
                        <i class="bi bi-bag-check-fill"></i>
                    </div>

                    <h2 class="login-title">Welcome</h2>

                    <p class="login-subtitle mb-4">
                        Login using your Google account to continue shopping.
                    </p>

                    <div class="alert alert-danger info-alert fw-semibold">
                        Please login to use Cart & Place Orders.
                    </div>

                    <a asp-controller="Account"
                       asp-action="GoogleLogin"
                       class="btn btn-google auth-btn mt-3">

                        <i class="bi bi-google me-2"></i>

                        Continue with Google

                    </a>

                </div>

            </div>

        </div>

        <!-- Manual Login -->

        <div class="col-lg-5 col-md-10">

            <div class="card login-card h-100">

                <div class="card-body">

                    <h2 class="login-title text-center">
                        Shopkeeper Login
                    </h2>

                    <p class="login-subtitle text-center mb-4">
                        Sign in to manage your shop.
                    </p>

                    @if (ViewData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">
                            @ViewData["ErrorMessage"]
                        </div>
                    }

                    <form asp-action="Login" method="post" class="needs-validation" novalidate>

                        <div class="mb-3">

                            <label asp-for="Email" class="form-label fw-semibold"></label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-envelope-fill"></i>
                                </span>

                                <input asp-for="Email"
                                       class="form-control"
                                       placeholder="Enter Email"
                                       required />

                            </div>

                            <span asp-validation-for="Email" class="text-danger"></span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Password" class="form-label fw-semibold"></label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-lock-fill"></i>
                                </span>

                                <input asp-for="Password"
                                       type="password"
                                       class="form-control"
                                       placeholder="Enter Password"
                                       required />

                            </div>

                            <span asp-validation-for="Password" class="text-danger"></span>

                        </div>

                        <button type="submit"
                                class="btn btn-warning auth-btn w-100">

                            <i class="bi bi-box-arrow-in-right me-2"></i>

                            Login

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}