@{
    ViewData["Title"] = "प्रामाणिक लाकूडतोड्या";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <div class="display-5 fw-bold text-primary">
            🪓 प्रामाणिक लाकूडतोड्या 🌳
        </div>

        <div class="text-muted fs-5 mt-2">
            प्रामाणिकपणाचे महत्त्व सांगणारी सुंदर बोधकथा
        </div>
    </div>

    <div class="card border-0 shadow-lg rounded-4">

        <div class="card-header bg-warning text-dark text-center fs-4 fw-bold rounded-top-4">
            📖 कथा
        </div>

        <div class="card-body p-5">

            <p class="fs-5 lh-lg text-dark">
                एका गावात एक गरीब लाकूडतोड्या राहत होता. तो रोज जंगलात जाऊन
                लाकूड तोडायचा आणि ते विकून आपल्या कुटुंबाचा उदरनिर्वाह करायचा.
            </p>

            <p class="fs-5 lh-lg">
                एके दिवशी तो जंगलात एका नदीकाठी असलेल्या झाडाचे लाकूड तोडत होता.
                लाकूड तोडत असताना अचानक त्याच्या हातातून कुऱ्हाड निसटली
                आणि नदीच्या खोल पाण्यात जाऊन पडली.
            </p>

            <p class="fs-5 lh-lg">
                लाकूडतोड्या खूप गरीब असल्यामुळे त्याच्याकडे दुसरी कुऱ्हाड
                घेण्यासाठी पैसे नव्हते. त्यामुळे तो नदीकिनारी बसून
                मोठ्याने रडू लागला.
            </p>

            <p class="fs-5 lh-lg">
                त्याचे रडणे ऐकून नदीतून एक देवी प्रकट झाली.
                तिने त्याला रडण्याचे कारण विचारले.
                लाकूडतोड्याने नम्रपणे घडलेली सर्व घटना सांगितली
                आणि आपली कुऱ्हाड परत मिळावी अशी विनंती केली.
            </p>

            <p class="fs-5 lh-lg">
                देवी नदीत गेली आणि एक सुंदर सोन्याची कुऱ्हाड घेऊन आली.
                ती म्हणाली,
                <strong>"ही घे, तुझी कुऱ्हाड."</strong>
                पण लाकूडतोड्या म्हणाला,
                <strong>"देवी, ही माझी कुऱ्हाड नाही."</strong>
            </p>

            <p class="fs-5 lh-lg">
                देवी पुन्हा नदीत गेली आणि यावेळी चांदीची कुऱ्हाड घेऊन आली.
                तिने पुन्हा विचारले,
                <strong>"ही तुझी कुऱ्हाड आहे का?"</strong>
                लाकूडतोड्याने पुन्हा नम्रपणे उत्तर दिले,
                <strong>"नाही देवी, ही देखील माझी नाही."</strong>
            </p>

            <p class="fs-5 lh-lg">
                तिसऱ्यांदा देवी नदीत गेली आणि यावेळी लाकूडतोड्याची
                लोखंडाची खरी कुऱ्हाड घेऊन आली.
                ती पाहताच लाकूडतोड्या आनंदाने म्हणाला,
                <strong>"हो देवी! हीच माझी कुऱ्हाड आहे."</strong>
            </p>

            <p class="fs-5 lh-lg">
                देवी त्याच्या प्रामाणिकपणावर खूप प्रसन्न झाली.
                ती म्हणाली,
                <strong>
                    "मी तुझी परीक्षा घेत होती.
                    तू प्रामाणिकपणे सत्य बोललास,
                    म्हणून बक्षीस म्हणून या तिन्ही कुऱ्हाडी तुलाच देते."
                </strong>
            </p>

            <p class="fs-5 lh-lg">
                लाकूडतोड्याने देवीचे मनापासून आभार मानले.
                त्यानंतर तो आनंदाने आपल्या घरी गेला.
                त्याच्या प्रामाणिकपणामुळे त्याचे पुढील आयुष्य सुखात आणि समाधानात गेले.
            </p>

        </div>

        <div class="card-footer bg-success text-white text-center rounded-bottom-4">

            <div class="fs-4 fw-bold mb-2">
                🌟 बोध 🌟
            </div>

            <div class="fs-5">
                <strong>
                    प्रामाणिकपणा हेच सर्वात मोठे धन आहे.
                    सत्य बोलणाऱ्या आणि प्रामाणिक माणसाला नेहमी योग्य फळ मिळते.
                </strong>
            </div>

        </div>

    </div>

    <div class="text-center mt-4">
        <a asp-controller="Story"
           asp-action="Index"
           class="btn btn-outline-primary btn-lg rounded-pill px-4">
            ← कथासंग्रहाकडे परत जा
        </a>
    </div>

</div>

<style>
    body {
        background: linear-gradient(135deg, #f8f9fa, #fff8e1);
    }

    .card {
        animation: fadeIn .7s ease-in-out;
    }

    p {
        text-align: justify;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>